---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReferralBanner from "../../components/ReferralBanner.astro";
import OnThisPage from "../../components/OnThisPage.astro";
import FaqSchema from "../../components/FaqSchema.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { REFERRAL_CODE, REFERRAL_LINK, REFERRAL_INFO_PATH } from "../../config/site";

const referralCode = REFERRAL_CODE;
const referralLink = REFERRAL_LINK;
const heroImg = "/assets/img/referral/star-citizen-referral-code-50000-uec-bonus-hero.webp";

const tocItems = [
  { id: "quick-answer", label: "Get the code" },
  { id: "do-this-now", label: "Copy + signup" },
  { id: "common-mistakes", label: "What usually goes wrong" },
  { id: "next-steps", label: "Next step" },
  { id: "faq", label: "FAQ" }
];

const faqItems = [
  { q: "How do I get a Star Citizen referral code?", a: "Get a valid code before you open signup, then use it during account creation. This page gives you one directly so you do not have to keep hunting for it." },
  { q: "Do I need a referral code to create an account?", a: "No. It is optional. Use one only if you want the signup bonus." },
  { q: "Does the code cost anything?", a: "No. It does not add fees and it does not change the price." },
  { q: "Can I add it later?", a: "RSI says brand-new accounts have a short 24-hour grace window after creation, but signup is still the normal path to plan around." },
  { q: "What should I do after I create the account?", a: "Keep that same account for Free Fly or for the starter pack you may buy later." }
];
---

<BaseLayout
  title="Where to Get a Star Citizen Referral Code | Star Citizen Beginner"
  description="Get one valid Star Citizen referral code before signup, use it during account creation, and keep the rest simple."
  canonicalPath="/get-a-star-citizen-referral-code/"
  pageType="satellite"
  pageTier="satellite"
  ogImage={heroImg}
  ogImageAlt="Get a Star Citizen referral code before signup"
  stickyCtaLabel="Create account + claim bonus"
  stickyCtaHref={referralLink}
  stickyCtaExternal={true}
  activeNav="guides"
>
  <main>
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Referral code", href: REFERRAL_INFO_PATH }, { label: "Get a referral code", href: "/get-a-star-citizen-referral-code/" }]} />

    <section class="hero guideHero">
      <img
        class="hero__img"
        src={heroImg}
        alt="Get a Star Citizen referral code before signup"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1536"
        height="1024"
      />
      <div class="hero__overlay"></div>

      <div class="hero__content">
        <div class="guideHero__content">
          <div class="kicker"><span class="dot"></span> Before signup</div>
          <h1 class="h1">Where to get a Star Citizen referral code</h1>
          <p class="lead" style="max-width: 820px;">Need one valid code before signup? Use the code below during account creation, then move on.</p>

          <div class="hero__cta">
            <a class="btn primary" href="#quick-answer">Get the code</a>
          </div>
        </div>

        <OnThisPage variant="hero" title="On this page" items={tocItems} />
      </div>
    </section>

    <ReferralBanner
      code={referralCode}
      bonus="50,000"
      ctaLabel="Create account + claim bonus"
      ctaHref={referralLink}
      ctaExternal={true}
    />

    <section id="quick-answer" class="section">
      <div class="container">
        <h2 class="h2">Quick answer</h2>

        <div class="card pad" style="margin-bottom: 12px;">
          <div class="kicker"><span class="dot"></span> Get the code</div>
          <p class="lead" style="margin-top: 10px;">Use referral code {referralCode} during account creation if you want the signup bonus. This page only solves the code-source question.</p>
        </div>

        <ul class="bullets">
          <li>Take the code before you start signup so you do not have to interrupt the flow later.</li>
          <li>The referral link is the easiest option because it opens signup with the code already filled in.</li>
          <li>The code is optional and it does not change your price.</li>
          <li>Need the exact field or the 24-hour backup window? Use the <a class="link" href={REFERRAL_INFO_PATH}>main referral guide</a>.</li>
        </ul>

        <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px;">
          <a class="btn primary" href={referralLink} rel="nofollow noopener" target="_blank">Create account + claim bonus</a>
          <a class="btn ghost" href={REFERRAL_INFO_PATH}>Need the full referral guide? →</a>
        </div>
      </div>
    </section>

    <section id="do-this-now" class="section alt">
      <div class="container">
        <h2 class="h2">Copy + signup</h2>

        <div class="card pad">
          <div class="grid-2">
            <div>
              <h3 class="card__title">Use this code</h3>
              <div class="codePillRow">
                <button class="codePill js-copyCode" type="button" aria-label={`Copy referral code ${referralCode} to clipboard`} title="Click to copy">{referralCode}</button>
              </div>
              <p class="muted" style="margin-top: 10px;">Use it during account creation, not later in checkout.</p>
            </div>
            <div>
              <h3 class="card__title">Do this now</h3>
              <ol class="steps">
                <li>Open the official signup page.</li>
                <li>Use the referral link or paste the code into “Referral Code (optional)”.</li>
                <li>Create the account and verify your email.</li>
                <li>Keep that same account for Free Fly or for the package you may buy later.</li>
              </ol>
            </div>
          </div>

          <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px;">
            <a class="btn primary" href={referralLink} rel="nofollow noopener" target="_blank">Create account + claim bonus</a>
            <a class="btn" href="/where-to-enter-referral-code/">Where to paste it</a>
          </div>
        </div>
      </div>
    </section>

    <section id="common-mistakes" class="section">
      <div class="container">
        <h2 class="h2">What usually goes wrong</h2>
        <div class="tableWrap">
          <table class="table">
            <thead>
              <tr>
                <th>Mistake</th>
                <th>What happens</th>
                <th>Do this instead</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><b>Starting signup first</b></td>
                <td>You rush through the form and forget the referral step.</td>
                <td>Get the code before you open signup.</td>
              </tr>
              <tr>
                <td><b>Waiting until checkout</b></td>
                <td>You look for a field that does not belong there.</td>
                <td>Use the code during account creation.</td>
              </tr>
              <tr>
                <td><b>Thinking the code changes the price</b></td>
                <td>You hesitate for the wrong reason.</td>
                <td>Treat it as a signup bonus only.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="next-steps" class="section alt">
      <div class="container">
        <h2 class="h2">Next step</h2>

        <ul class="bullets">
          <li><a href="/where-to-enter-referral-code/">Where to enter the code</a> — use this if you only want the exact signup field.</li>
          <li><a href="/referral-bonus-checklist/">Referral bonus checklist</a> — the shortest clean signup path.</li>
          <li><a href="/free-fly/">Free Fly</a> — create the account now and test the game before you spend money.</li>
          <li><a href={REFERRAL_INFO_PATH}>Main referral guide</a> — the full answer on timing, bonus, and the backup window.</li>
        </ul>
      </div>
    </section>

    <section id="faq" class="section">
      <div class="container">
        <h2 class="h2">FAQ</h2>
        <div class="faq" style="margin-top: 12px;">
          {faqItems.map((item) => (
            <details class="faq__item">
              <summary class="faq__q">{item.q}</summary>
              <div class="faq__a">{item.a}</div>
            </details>
          ))}
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px;">
          <a class="btn primary" href={referralLink} rel="nofollow noopener" target="_blank">Create account + claim bonus</a>
          <a class="btn ghost" href={REFERRAL_INFO_PATH}>Need the full referral guide? →</a>
        </div>
      </div>

      <FaqSchema items={faqItems} />
    </section>
  </main>
</BaseLayout>
