---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReferralBanner from "../../components/ReferralBanner.astro";
import OnThisPage from "../../components/OnThisPage.astro";
import FaqSchema from "../../components/FaqSchema.astro";
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { REFERRAL_CODE, REFERRAL_LINK, REFERRAL_BONUS_UEC, FREE_FLY_HUB_PATH, SHOULD_YOU_BUY_PATH, PERFORMANCE_GUIDE_PATH } from "../../config/site";

const referralCode = REFERRAL_CODE;
const referralLink = REFERRAL_LINK;
const heroImg = "/assets/img/free-fly/star-citizen-free-fly-hero.webp";

const tocItems = [
  { id: "quick-answer", label: "Quick answer" },
  { id: "do-this-now", label: "Do this now" },
  { id: "common-mistakes", label: "What goes wrong" },
  { id: "next-steps", label: "Next steps" },
  { id: "faq", label: "FAQ" }
];

const faqItems = [
  { q: "Can I try Star Citizen without buying a package?", a: "Yes. The normal beginner-safe way is waiting for a Free Fly event, creating an RSI account, and using the event window as your trial run." },
  { q: "Is this page different from the full Free Fly guide?", a: "Yes. This page only answers the narrow question of how to try the game without buying. The full Free Fly guide covers the wider event flow and what to test." },
  { q: "What should I actually do in my first trial session?", a: "Keep it to one simple loop: get in, claim a ship, finish one easy contract, then decide whether you want another session." },
  { q: "What if the game runs badly during the trial?", a: "Do not make your buy-or-skip decision from one rough session. Retest with a short loop and use the performance guide if the game feels rough everywhere." },
  { q: "Where does the referral code fit?", a: `If you want the signup bonus of ${REFERRAL_BONUS_UEC} UEC, use the referral code during account creation before you start the trial.` }
];
---

<BaseLayout
  title="Try Star Citizen Without Buying: Start with Free Fly | Star Citizen Beginner"
  description="Try Star Citizen without buying by using Free Fly first. This page gives you the clean beginner path: create the account, run one fair test, then decide later."
  canonicalPath="/try-star-citizen-without-buying/"
  pageType="satellite"
  pageTier="satellite"
  ogImage={heroImg}
  ogImageAlt="Try Star Citizen without buying during Free Fly"
  stickyCtaLabel="Open full Free Fly guide"
  stickyCtaHref={FREE_FLY_HUB_PATH}
  activeNav="free-fly"
>
  <main>
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Free Fly', href: FREE_FLY_HUB_PATH }, { label: 'Try without buying', href: '/try-star-citizen-without-buying/' }]} />

    <section class="hero guideHero">
      <img
        class="hero__img"
        src={heroImg}
        alt="Try Star Citizen without buying during Free Fly"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1536"
        height="1024"
      />
      <div class="hero__overlay"></div>

      <div class="hero__content">
        <div class="guideHero__content">
          <div class="kicker"><span class="dot"></span> Before you buy</div>
          <h1 class="h1">Try Star Citizen without buying</h1>
          <p class="lead" style="max-width: 820px;">The clean beginner path is simple: wait for Free Fly, create the account correctly, run one fair test session, then decide later whether the game is worth your money.</p>

          <div class="hero__cta">
            <a class="btn primary" href="#quick-answer">Start here</a>
          </div>
        </div>

        <OnThisPage variant="hero" title="On this page" items={tocItems} />
      </div>
    </section>

    <ReferralBanner
      code={referralCode}
      bonus={`${REFERRAL_BONUS_UEC} UEC`}
      ctaLabel="Create account + claim bonus"
      ctaHref={referralLink}
      ctaExternal={true}
      howItWorksHref="/star-citizen-referral-code/"
      sublineHtml="Use the code during <b>account creation</b>. Free Fly is the test phase, not the time to improvise your signup."
    />

    <section id="quick-answer" class="section">
      <div class="container">
        <h2 class="h2">Quick answer</h2>

        <div class="card pad" style="margin-bottom:12px;">
          <div class="kicker"><span class="dot"></span> Short path</div>
          <p class="lead" style="margin-top:10px;">Use Free Fly as your trial run. Get the account setup right, run one simple session, and only think about buying after the game gives you one fair yes.</p>
        </div>

        <ul class="bullets">
          <li><b>Do not buy first just to test.</b> Free Fly already answers the core beginner question: do you actually want more of this?</li>
          <li><b>Keep the trial narrow.</b> One clean loop tells you more than forcing ten systems into one chaotic evening.</li>
          <li><b>Judge the game fairly.</b> If the session is rough because of queues, lag, or bad setup, retest before you turn that into a permanent no.</li>
          <li><b>Use the full Free Fly guide for context.</b> This page only solves the narrow “try without buying” question.</li>
        </ul>
      </div>
    </section>

    <section id="do-this-now" class="section alt">
      <div class="container">
        <h2 class="h2">Do this now</h2>
        <ol class="steps">
          <li><b>Check whether Free Fly is active</b> and use that event window as your test instead of buying a package first.</li>
          <li><b>Create the RSI account cleanly</b> and use the referral code during signup if you want the beginner bonus.</li>
          <li><b>Run one short first session</b> so you can answer the real question: do you want another session after this one?</li>
          <li><b>Only look at buying after the test</b> if the game felt good enough that you want to come back on purpose.</li>
        </ol>
      </div>
    </section>

    <section id="common-mistakes" class="section">
      <div class="container">
        <h2 class="h2">What usually goes wrong</h2>
        <div class="tableWrap">
          <table class="table">
            <thead>
              <tr>
                <th>Mistake</th>
                <th>What happens</th>
                <th>Do this instead</th>
              </tr>
            </thead>
            <tbody>
              <tr><td><b>Treating the trial like a full hobby start</b></td><td>You overload yourself before you even know if the game clicks.</td><td>Use Free Fly only to get one fair first impression.</td></tr>
              <tr><td><b>Judging the game from one ugly session</b></td><td>You mistake event chaos or setup issues for the whole game.</td><td>Retest with a short loop and use the performance guide if needed.</td></tr>
              <tr><td><b>Buying before the test says yes</b></td><td>You spend money before the game has earned it.</td><td>Let Free Fly answer the trial question first, then move to buying later.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="next-steps" class="section alt">
      <div class="container">
        <h2 class="h2">Next steps</h2>
        <ul class="bullets">
          <li><a href={FREE_FLY_HUB_PATH}>Open the full Free Fly guide</a> if you want the wider event path, expectations, and handoffs.</li>
          <li><a href="/free-fly-first-session/">Run a clean first Free Fly session</a> if you want the shortest beginner-safe trial loop.</li>
          <li><a href="/star-citizen-performance-guide/">Fix performance before you decide</a> if your trial felt rough everywhere.</li>
          <li><a href="/should-you-buy-star-citizen/">Use the buy-or-wait reality check</a> once the test is done and you still are not sure.</li>
          <li><a href="/how-to-buy-star-citizen/">Use the buying guide</a> only after the trial already gave you a yes.</li>
        </ul>
      </div>
    </section>

    <section id="faq" class="section">
      <div class="container">
        <h2 class="h2">FAQ</h2>
        <div class="faq" style="margin-top:12px;">
          {faqItems.map((item) => (
            <details class="faq__item">
              <summary class="faq__q">{item.q}</summary>
              <div class="faq__a">{item.a}</div>
            </details>
          ))}
        </div>
      </div>

      <FaqSchema items={faqItems} />
    </section>
  </main>
</BaseLayout>
