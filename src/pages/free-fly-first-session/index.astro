---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReferralBanner from "../../components/ReferralBanner.astro";
import OnThisPage from "../../components/OnThisPage.astro";
import FaqSchema from "../../components/FaqSchema.astro";
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { REFERRAL_CODE, REFERRAL_LINK, REFERRAL_BONUS_UEC, FREE_FLY_HUB_PATH } from "../../config/site";

const referralCode = REFERRAL_CODE;
const referralLink = REFERRAL_LINK;
const heroImg = "/assets/img/free-fly/star-citizen-free-fly-hero.webp";

const tocItems = [
  { id: "quick-answer", label: "Quick answer" },
  { id: "do-this-now", label: "Do this now" },
  { id: "common-mistakes", label: "What goes wrong" },
  { id: "next-steps", label: "Next steps" },
  { id: "faq", label: "FAQ" }
];

const faqItems = [
  { q: "Can I do this without buying a package?", a: "Yes. This page is for the Free Fly version of your first session, where you use the event window as your trial run." },
  { q: "What is the best first contract type?", a: "A single simple delivery or courier job is still the cleanest first test because it teaches movement, terminals, ship handling, and a clean finish." },
  { q: "What if I cannot find my ship?", a: "Use an ASOP terminal to retrieve it. If the ship is unavailable or destroyed, claim it and keep the rest of the test session simple." },
  { q: "Should I test solo or with a friend?", a: "Solo is enough for the first loop. One experienced friend can reduce confusion, but you still want one clear session you can judge for yourself." },
  { q: "When should I think about buying?", a: "Only after one clean first loop and at least one session you would actually want to repeat." }
];
---

<BaseLayout
  title="Free Fly First Session: What to Do First | Star Citizen Beginner"
  description="Use this Free Fly first-session plan to get one fair beginner test in your first hour: claim a ship, finish one simple loop, then decide what to do next."
  canonicalPath="/free-fly-first-session/"
  pageType="satellite"
  pageTier="satellite"
  ogImage={heroImg}
  ogImageAlt="Free Fly first session plan"
  stickyCtaLabel="Open full Free Fly guide"
  stickyCtaHref={FREE_FLY_HUB_PATH}
  activeNav="free-fly"
>
  <main>
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Free Fly', href: FREE_FLY_HUB_PATH }, { label: 'First Free Fly session', href: '/free-fly-first-session/' }]} />

    <section class="hero guideHero">
      <img
        class="hero__img"
        src={heroImg}
        alt="Free Fly first session plan"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1536"
        height="1024"
      />
      <div class="hero__overlay"></div>

      <div class="hero__content">
        <div class="guideHero__content">
          <div class="kicker"><span class="dot"></span> First hour</div>
          <h1 class="h1">Free Fly first session: what to do first</h1>
          <p class="lead" style="max-width: 820px;">Use this page when Free Fly is already live and you want one clean beginner-safe first hour. The job is simple: leave the station, finish one easy loop, and log out with a fair impression.</p>

          <div class="hero__cta">
            <a class="btn primary" href="#quick-answer">Start here</a>
          </div>
        </div>

        <OnThisPage variant="hero" title="On this page" items={tocItems} />
      </div>
    </section>

    <ReferralBanner
      code={referralCode}
      bonus={`${REFERRAL_BONUS_UEC} UEC`}
      ctaLabel="Create account + claim bonus"
      ctaHref={referralLink}
      ctaExternal={true}
      howItWorksHref="/star-citizen-referral-code/"
      sublineHtml="Use the code during <b>account creation</b>. Then keep the first session simple instead of mixing signup stress with gameplay."
    />

    <section id="quick-answer" class="section">
      <div class="container">
        <h2 class="h2">Quick answer</h2>

        <div class="card pad" style="margin-bottom:12px;">
          <div class="kicker"><span class="dot"></span> Short plan</div>
          <p class="lead" style="margin-top:10px;">Your first Free Fly hour is not for exploring everything. It is for one clean loop that tells you whether the basic feel of the game is worth more time.</p>
        </div>

        <ul class="bullets">
          <li><b>Keep the first loop easy.</b> Spawn, claim a ship, leave the city, complete one simple contract, then stop.</li>
          <li><b>Use this only for the event version</b> of your first hour. The main first-session guide is broader and less tied to Free Fly conditions.</li>
          <li><b>Do not open on hard mode.</b> Skip bunkers, long cargo chains, and anything that needs too much context on day one.</li>
          <li><b>If the session feels rough, retest.</b> Event chaos and setup problems can still distort an otherwise good beginner fit.</li>
        </ul>
      </div>
    </section>

    <section id="do-this-now" class="section alt">
      <div class="container">
        <h2 class="h2">Do this now</h2>
        <ol class="steps">
          <li><b>Set your spawn and orient yourself once</b> so you do not repeat the same long walk if something goes wrong.</li>
          <li><b>Use an ASOP terminal, claim your ship, and do one takeoff and landing</b> before you stack more pressure on the session.</li>
          <li><b>Run one short courier or delivery loop</b> that teaches terminals, travel, landing, and a clean finish.</li>
          <li><b>Stop after the win</b> and ask the only question that matters: would you willingly run another session after this one?</li>
          <li><b>If the answer is unclear because the session was rough</b>, retest instead of turning that straight into a no.</li>
        </ol>
      </div>
    </section>

    <section id="common-mistakes" class="section">
      <div class="container">
        <h2 class="h2">What usually goes wrong</h2>
        <div class="tableWrap">
          <table class="table">
            <thead>
              <tr>
                <th>Mistake</th>
                <th>What happens</th>
                <th>Do this instead</th>
              </tr>
            </thead>
            <tbody>
              <tr><td><b>Starting with the wrong kind of mission</b></td><td>You turn the first hour into confusion and gear loss.</td><td>Use one simple courier or delivery loop first.</td></tr>
              <tr><td><b>Switching goals every five minutes</b></td><td>You never get a fair read on the core loop.</td><td>Finish one clean loop before you try anything else.</td></tr>
              <tr><td><b>Judging the whole game from one chaotic moment</b></td><td>You confuse event conditions with the actual fit of the game.</td><td>Retest once under calmer conditions or after basic fixes.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="next-steps" class="section alt">
      <div class="container">
        <h2 class="h2">Next steps</h2>
        <ul class="bullets">
          <li><a href={FREE_FLY_HUB_PATH}>Open the full Free Fly guide</a> if you want the wider event context before or after this first hour.</li>
          <li><a href="/first-session/">Open the broader first-session guide</a> if you want the non-Free-Fly version of the same beginner flow.</li>
          <li><a href="/free-fly-what-do-i-keep/">See what carries over after Free Fly</a> if the first test worked and you are thinking about later buying.</li>
          <li><a href="/how-to-buy-star-citizen/">Use the buying guide</a> only after this first hour already gave you a reason to come back.</li>
        </ul>
      </div>
    </section>

    <section id="faq" class="section">
      <div class="container">
        <h2 class="h2">FAQ</h2>
        <div class="faq" style="margin-top:12px;">
          {faqItems.map((item) => (
            <details class="faq__item">
              <summary class="faq__q">{item.q}</summary>
              <div class="faq__a">{item.a}</div>
            </details>
          ))}
        </div>
      </div>

      <FaqSchema items={faqItems} />
    </section>
  </main>
</BaseLayout>
