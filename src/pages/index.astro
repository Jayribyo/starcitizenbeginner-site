---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReferralBanner from "../components/ReferralBanner.astro";
import OnThisPage from "../components/OnThisPage.astro";
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqSchema from "../components/FaqSchema.astro";
import { REFERRAL_CODE, REFERRAL_LINK, REFERRAL_INFO_PATH, REFERRAL_BONUS_UEC, FLY_FREE_URL } from "../config/site";

const referralCode = REFERRAL_CODE;
const referralLink = REFERRAL_LINK;
const referralPage = REFERRAL_INFO_PATH;

const homeFaqItems = [
  { q: "Can I try Star Citizen without buying?", a: "Yes. Use Free Fly to test the game first and follow a simple first-session plan." },
  { q: "What’s the smartest first thing to do in-game?", a: "Run one simple contract and repeat it once or twice. It teaches travel, menus, and mission flow without making your first session feel chaotic." },
  { q: "Do I need a strong PC?", a: "You need a solid baseline and the right settings. If the game stutters, fix performance first with a targeted performance guide." },
  { q: "What starter pack should I buy?", a: "Pick the cheapest game package that fits the way you want to start. One game package is enough to begin, and you can change direction later." },
  { q: "Do I need a subscription to play?", a: "No. A subscription is optional. To play outside Free Fly, you just need one game package on your account." },
  { q: "What happens right after I buy?", a: "Open My Hangar once to make sure your package is there, then download the launcher, install the game, and use a simple first-session plan." },
  { q: "Is the referral code mandatory?", a: "No. It is optional and does not change your price. If you want the signup bonus, enter it during account creation." },
  { q: "Where do I enter the referral code?", a: "On the RSI signup page during account creation. The referral guide shows the exact place." },
];

const tiles = [
  {
    href: "/free-fly/",
    img: "/assets/img/home/tiles/star-citizen-free-fly-tile.webp",
    title: "Free Fly",
    desc: "Try Star Citizen first and learn what Free Fly can and cannot tell you.",
    pill: "Try first",
  },
  {
    href: "/should-you-buy-star-citizen/",
    img: "/assets/img/home/tiles/scb-tile-beginner-tips.webp",
    title: "Should You Buy?",
    desc: "Use a calm yes-or-no check if you are still deciding whether the game is for you.",
    pill: "Decide first",
  },
  {
    href: "/star-citizen-starter-packs/",
    img: "/assets/img/home/tiles/scb-tile-starter-pack.webp",
    title: "Starter Packs",
    desc: "Choose one sensible starter pack without overbuying or chasing the wrong thing.",
    pill: "Buy smart",
  },
  {
    href: "/beginner-tips/",
    img: "/assets/img/home/tiles/scb-tile-beginner-tips.webp",
    title: "Beginner Tips",
    desc: "Start simple, avoid fake difficulty, and build one repeatable beginner routine.",
    pill: "Start simple",
  },
  {
    href: "/star-citizen-performance-guide/",
    img: "/assets/img/home/tiles/scb-tile-performance-settings.webp",
    title: "Performance & FPS",
    desc: "Fix stutter, crashes, and bad first impressions before you judge the game.",
    pill: "Fix the game",
  },
  {
    href: "/make-money-fast/",
    img: "/assets/img/home/tiles/scb-tile-make-money-fast.webp",
    title: "Make Money Fast",
    desc: "Use one forgiving early money loop after your first session feels stable.",
    pill: "Earn later",
  },
];
---

<BaseLayout
  title="Star Citizen Beginner Guide – Start Simple and Enjoy Your First Sessions"
  description="New to Star Citizen? Start here for clear beginner help: try Free Fly, choose one starter pack, fix performance issues, and make your first sessions much easier to enjoy."
  canonicalPath="/"
  stickyCtaLabel="Claim signup bonus (+50k UEC)"
  stickyCtaHref={referralLink}
  stickyCtaExternal={true}
 activeNav="home">
<link slot="head" rel="preload" as="image" href="/assets/img/home/scb-home-hero.webp" fetchpriority="high" />
  <FaqSchema items={homeFaqItems} />
  <main>

    <Breadcrumbs items={[{ label: 'Home', href: '/' }]} />
    <!-- ===================== HERO ===================== -->
    <section class="hero">
 <img
  class="hero__img"
  src="/assets/img/home/scb-home-hero.webp"
  alt="Star Citizen spaceship flying above a planet"
  loading="eager"
  fetchpriority="high"
  decoding="async"
  width="1536"
  height="1024"
/>
      <div class="hero__overlay"></div>

      <div class="hero__content">
        <div class="homeHero__content">
          <div style="max-width:720px; padding: 26px 0;">
            <h1 class="h1">Star Citizen Beginner Guide</h1>
          <p class="lead">New to Star Citizen? You do not need to solve everything today. Pick one safe next step, avoid the mistakes that create fake difficulty, and get into the game without turning the start into a project.</p>

            <div class="btnrow">
              <a class="btn primary" href="#situation" data-scb-role="hero-start-route">Find your safest next step</a>
            </div>
          </div>
        </div>
      </div>

      <!-- ON THIS PAGE (integrated into hero on desktop) -->
      <OnThisPage
        variant="hero"
        title="On this page"
        items={[
          { label: "Pick your path", href: "#situation" },
          { label: "Mistakes", href: "#mistakes" },
          { label: "First hour", href: "#first-hour" },
          { label: "Go deeper", href: "#guides" },
          { label: "FAQ", href: "#faq" },
        ]}
      />
    </section>

    <!-- Referral banner (consistent with referral page) -->
    <ReferralBanner
      code={referralCode}
      bonus="50,000 UEC"
      ctaHref={referralLink}
      howItWorksHref={`${referralPage}#how-to-use`}
      sublineHtml="Optional, free, and easy to use during signup. It does not change your price — it just adds the signup bonus."
      ariaLabel="Referral bonus callout"
    />
    <!-- ===================== PICK YOUR SITUATION ===================== -->
    <section id="situation" class="section">
      <div class="card pad">
        <h2 class="section__title">Pick the line that sounds like you</h2>
        <p style="max-width:980px;">Start with the line that matches your situation right now. Solve that one problem first, then ignore the rest until the start feels less messy.</p>

        <div class="decisionGrid" style="margin-top:14px;">
          <a class="decisionCard" href="/free-fly/" style="text-decoration:none; color:inherit; display:block;">
            <div class="decisionCard__kicker">Try first</div>
            <div class="decisionCard__title">I want to test the game before I buy</div>
            <p class="decisionCard__body">Use Free Fly as a low-risk test path before you spend money.</p>
          </a>
          <a class="decisionCard" href="/should-you-buy-star-citizen/" style="text-decoration:none; color:inherit; display:block;">
            <div class="decisionCard__kicker">Decide first</div>
            <div class="decisionCard__title">I am still deciding whether it is worth it</div>
            <p class="decisionCard__body">Use one calm yes-or-no check before you think about packs, ships, or spending more.</p>
          </a>
          <a class="decisionCard" href="/star-citizen-starter-packs/" style="text-decoration:none; color:inherit; display:block;">
            <div class="decisionCard__kicker">Buy smart</div>
            <div class="decisionCard__title">I am ready to buy and want one sensible pack</div>
            <p class="decisionCard__body">Choose one sensible starter pack and leave bigger ships and upgrades for later.</p>
          </a>
          <a class="decisionCard" href="/star-citizen-performance-guide/" style="text-decoration:none; color:inherit; display:block;">
            <div class="decisionCard__kicker">Fix the game</div>
            <div class="decisionCard__title">The game runs badly and I do not know why</div>
            <p class="decisionCard__body">Start with the clean baseline and the small fixes that remove fake difficulty before you judge the game.</p>
          </a>
          <a class="decisionCard" href="#first-hour" style="text-decoration:none; color:inherit; display:block;">
            <div class="decisionCard__kicker">Start simple</div>
            <div class="decisionCard__title">I already bought and just need a calm first session</div>
            <p class="decisionCard__body">Run one safe loop, keep your gear cheap, and stop after one clean success.</p>
          </a>
          <a class="decisionCard" href="/make-money-fast/" style="text-decoration:none; color:inherit; display:block;">
            <div class="decisionCard__kicker">Earn later</div>
            <div class="decisionCard__title">I want easy beginner credits after I stop feeling lost</div>
            <p class="decisionCard__body">Use one forgiving loop after your first session feels stable. Money comes later.</p>
          </a>
        </div>

        <div class="card" style="margin-top:14px;">
          <div class="pad">
            <div class="kicker"><span class="dot"></span> Quick truth</div>
            <p style="margin:0;">Most bad first impressions come from trying to solve too much at once: buying early, changing random settings, carrying too much gear, or treating one rough session like the final verdict.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== COMMON MISTAKES ===================== -->
    <section id="mistakes" class="section">
      <div class="card pad">
        <div class="kicker"><span class="dot"></span> Trust block</div>
        <h2 class="section__title">The mistakes that make beginners quit too early</h2>
        <p style="max-width:980px;">These mistakes create fake difficulty, wasted time, and bad first impressions. Fix them once and the start gets much easier.</p>

        <div class="card" style="margin-top:14px;">
          <div class="pad">
            <div class="kicker"><span class="dot"></span> Keep the bar low</div>
            <p style="margin:0;">A good first session is simple: spawn, travel, finish one safe task, and end the session cleanly.</p>
          </div>
        </div>

        <div class="decisionGrid" style="margin-top:14px;">
          <div class="decisionCard">
            <div class="decisionCard__title">Trying to learn everything at once</div>
            <p class="decisionCard__body">You turn a simple first session into ten different goals, random choices, and slow progress.</p>
            <p class="muted" style="margin:10px 0 0;">Fix: pick one safe loop only, repeat it 2–3 times, then expand later. Start here: <a href="/beginner-tips/">Beginner tips →</a></p>
          </div>
          <div class="decisionCard">
            <div class="decisionCard__title">Judging the game while it stutters</div>
            <p class="decisionCard__body">A bad frame-time or crash-heavy session can make the whole game feel worse than it really is.</p>
            <p class="muted" style="margin:10px 0 0;">Fix: use the <a href="/star-citizen-performance-guide/">performance guide →</a> before deciding how the game actually feels.</p>
          </div>
          <div class="decisionCard">
            <div class="decisionCard__title">Buying extra ships too early</div>
            <p class="decisionCard__body">You spend more money before you know your real playstyle, and the extra ship rarely solves the real early-game problem.</p>
            <p class="muted" style="margin:10px 0 0;">Fix: start with one pack only. Use <a href="/star-citizen-starter-packs/">Starter packs →</a></p>
          </div>
          <div class="decisionCard">
            <div class="decisionCard__title">Skipping a structured Free Fly test</div>
            <p class="decisionCard__body">You test the wrong things, miss the fun, and treat event chaos like a fair picture of normal play.</p>
            <p class="muted" style="margin:10px 0 0;">Fix: use the <a href="/free-fly/">Free Fly guide →</a> with a simple first-session plan.</p>
          </div>
          <div class="decisionCard">
            <div class="decisionCard__title">Missing the signup bonus window</div>
            <p class="decisionCard__body">You create the account cleanly, but you lose the easy extra starting credits because the field was skipped.</p>
            <p class="muted" style="margin:10px 0 0;">Fix: enter the code during account creation: <a href={referralLink} target="_blank" rel="nofollow noopener noreferrer">Create account + claim bonus →</a></p>
          </div>
        </div>
      </div>
        <div class="card" style="margin-top:14px;">
          <div class="pad">
            <div class="kicker"><span class="dot"></span> What this block is really telling you</div>
            <p style="margin:0;">If the start feels awful, it is usually not because you are bad at the game. It is usually because you tried too much at once or judged the game from a bad technical baseline.</p>
          </div>
        </div>
    </section>

    <!-- ===================== FIRST HOUR ===================== -->
    <section id="first-hour" class="section">
      <div class="card pad">
        <h2 class="section__title">What to do in your first hour</h2>
        <p style="max-width: 980px;">Your first hour does not need to be productive. It only needs to give you one calm loop you can repeat.</p>

        <div class="card" style="margin-top:14px;">
          <div class="pad">
            <div class="kicker"><span class="dot"></span> Use this as a minimum plan</div>
            <p style="margin:0;">Do not optimize. Do not go shopping. Do not try five mission types. Just prove that you can spawn, travel, finish one safe task, and end the session cleanly.</p>
          </div>
        </div>

        <div class="decisionGrid" style="margin-top:14px;">
          <div class="decisionCard">
            <div class="decisionCard__kicker">1</div>
            <div class="decisionCard__title">Set your home and claim your ship</div>
            <p class="decisionCard__body">Get the basic loop working first: wake up, move through the station, use the ASOP terminal, and find your ship without panic.</p>
          </div>
          <div class="decisionCard">
            <div class="decisionCard__kicker">2</div>
            <div class="decisionCard__title">Run one simple courier or delivery contract</div>
            <p class="decisionCard__body">This teaches travel, navigation, basic interaction, and mission flow with much less risk than trying to do everything at once.</p>
          </div>
          <div class="decisionCard">
            <div class="decisionCard__kicker">3</div>
            <div class="decisionCard__title">Repeat the same loop once or twice</div>
            <p class="decisionCard__body">The first success matters less than the first repeat. Repetition turns confusion into routine and reveals the real pain points.</p>
          </div>
        </div>

        <div class="card" style="margin-top:14px;">
          <div class="pad">
            <div class="kicker"><span class="dot"></span> Keep it simple</div>
            <p style="margin:0;">Keep your gear cheap, your route obvious, and your expectations small. If the game still feels rough after one clean loop, fix performance first and then try the same session again.</p>
          </div>
        </div>

        <div class="btnrow" style="margin-top:14px; flex-wrap: wrap;">
          <a class="btn primary" href="/beginner-tips/">Open beginner tips</a>
          <a class="btn ghost" href="/satellites/first-session/">First session checklist →</a>
        </div>
      </div>
    </section>

    <!-- ===================== GUIDES ===================== -->
    <section id="guides" class="section">
      <div class="card pad">
        <div class="kicker"><span class="dot"></span> Go deeper only if you need it</div>
        <h2 class="section__title">Go deeper only when you need it</h2>
        <p class="lead">You do not need all of these today. Open one only when that specific problem is blocking you right now.</p>
      </div>

      <div class="tiles">
        {tiles.map((t) => (
          <a class="tile" href={t.href}>
            <img
  class="tile__img"
  src={t.img}
  alt={t.title}
  loading="lazy"
  decoding="async"
  width="1024"
  height="1024"
/>
            <div class="tile__meta">
              <span class="tile__pill">{t.pill}</span>
              <h3 class="tile__title">{t.title}</h3>
              <p class="tile__desc">{t.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ===================== FAQ ===================== -->
    
    <section id="related-answers" class="section alt">
      <div class="container">
        <h2 class="h2">Useful follow-ups</h2>
        <p class="muted" style="margin:0 0 12px; max-width: 860px;">Use one of these only if your main path still leaves you stuck on something specific.</p>
        <ul class="bullets">
            <li><a href="/satellites/first-session/">First session checklist (easy first hour)</a></li>
            <li><a href="/satellites/fix-stuttering/">Fix stuttering (SSD/RAM checklist)</a></li>
            <li><a href="/satellites/where-to-enter-referral-code/">Where to enter the referral code</a></li>
            <li><a href="/satellites/glossary/">Beginner glossary (key terms)</a></li>
        </ul>
      </div>
    </section>

<section id="faq" class="section">
      <div class="card pad">
        <h2 class="section__title">FAQ</h2>
        <p class="muted" style="margin-top:0; max-width: 860px;">These are the beginner questions that usually matter before the game starts to feel understandable.</p>
        <div class="faq" style="margin-top:12px;">
          <details class="faq__item">
            <summary class="faq__q">Can I try Star Citizen without buying?</summary>
            <div class="faq__a">Yes. Use <a href="/free-fly/" data-scb-role="internal-free-fly-guide">Free Fly →</a> to test the game first and follow a structured first session plan.</div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">What’s the smartest first thing to do in-game?</summary>
            <div class="faq__a">Run one simple contract loop (delivery/courier) and repeat it 2–3 times. It teaches travel, UI, and pays you without heavy risk.</div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">Do I need a strong PC?</summary>
            <div class="faq__a">You need a solid baseline and the right settings. If the game stutters, fix performance first: <a href="/star-citizen-performance-guide/">Performance guide →</a></div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">What starter pack should I buy?</summary>
            <div class="faq__a">Pick a pack that matches your first loop and buy the minimum. Use this: <a href="/star-citizen-starter-packs/">Starter packs guide →</a></div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">Is the referral code mandatory?</summary>
            <div class="faq__a">No. It’s optional and doesn’t change your price. If you want the free starting credits, enter it during signup: <a href="/star-citizen-referral-code/">how it works →</a></div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">Can I use these guides during Free Fly?</summary>
            <div class="faq__a">Yes. The same first-session checklist and money tips still help — you are just trying the game before buying.</div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">How do I make money fast as a beginner?</summary>
            <div class="faq__a">Start with simple delivery loops, then branch out into bounties or mining. Full guide here: <a href="/make-money-fast/">Make money fast →</a></div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">What should I avoid in my first hours?</summary>
            <div class="faq__a">Avoid all-in trading, expensive gear runs, and changing 20 settings at once. Build one repeatable loop first.</div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">I’m overwhelmed. What is the easiest way to start?</summary>
            <div class="faq__a">Follow the <a href="#first-hour">first-hour section</a> on this page and ignore the rest until you finish one full loop.</div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">Where do I enter the referral code?</summary>
            <div class="faq__a">On the RSI signup page during account creation. If you want it handy right here, copy <button class="codePill js-copyCode" type="button" data-copy-referral={referralCode} aria-label={`Copy referral code ${referralCode} to clipboard`} title="Click to copy">{referralCode}</button> and paste it into the field labeled “Referral Code (optional)”.</div>
          </details>
        </div>

        <div class="btnrow" style="margin-top:14px; flex-wrap: wrap;">
          <a class="btn primary" href={referralLink} target="_blank" rel="nofollow noopener noreferrer">Create account and claim signup bonus</a>
          <a class="btn ghost" href="/star-citizen-referral-code/">Referral code guide →</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>










