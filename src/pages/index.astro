---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReferralBanner from "../components/ReferralBanner.astro";
import OnThisPage from "../components/OnThisPage.astro";
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqSchema from "../components/FaqSchema.astro";
import { REFERRAL_CODE, REFERRAL_LINK, REFERRAL_INFO_PATH, REFERRAL_BONUS_UEC, FLY_FREE_URL } from "../config/site";

const referralCode = REFERRAL_CODE;
const referralLink = REFERRAL_LINK;
const referralPage = REFERRAL_INFO_PATH;

const homeFaqItems = [
  { q: "Can I try Star Citizen without buying?", a: "Yes. Use Free Fly to test the game first and follow a simple first-session plan." },
  { q: "What’s the smartest first thing to do in-game?", a: "Run one simple contract and repeat it once or twice. It teaches travel, menus, and mission flow without making your first session feel chaotic." },
  { q: "Do I need a strong PC?", a: "You need a solid baseline and the right settings. If the game stutters, fix performance first with a targeted performance guide." },
  { q: "What starter pack should I buy?", a: "Pick the cheapest game package that fits the way you want to start. One game package is enough to begin, and you can change direction later." },
  { q: "Do I need a subscription to play?", a: "No. A subscription is optional. To play outside Free Fly, you just need one game package on your account." },
  { q: "What happens right after I buy?", a: "Open My Hangar once to make sure your package is there, then download the launcher, install the game, and use a simple first-session plan." },
  { q: "Is the referral code mandatory?", a: "No. It is optional and does not change your price. If you want the signup bonus, enter it during account creation." },
  { q: "Where do I enter the referral code?", a: "On the RSI signup page during account creation. The referral guide shows the exact place." },
];

const tiles = [
  {
    href: "/beginner-tips/",
    img: "/assets/img/home/tiles/scb-tile-beginner-tips.webp",
    title: "Beginner Tips",
    desc: "Start simple, avoid fake difficulty, and build one repeatable routine.",
    pill: "I just want a simple start",
  },
  {
    href: "/free-fly/",
    img: "/assets/img/home/tiles/star-citizen-free-fly-tile.webp",
    title: "Free Fly",
    desc: "Try the game first and learn what Free Fly can and cannot tell you.",
    pill: "I want to try first",
  },
  {
    href: "/star-citizen-starter-packs/",
    img: "/assets/img/home/tiles/scb-tile-starter-pack.webp",
    title: "Starter Packs",
    desc: "Choose one starter pack without overbuying or second-guessing the basics.",
    pill: "I am ready to buy",
  },
  {
    href: "/make-money-fast/",
    img: "/assets/img/home/tiles/scb-tile-make-money-fast.webp",
    title: "Make Money Fast",
    desc: "Use one forgiving early money loop after your first session feels stable.",
    pill: "I need early credits",
  },
  {
    href: "/star-citizen-performance-guide/",
    img: "/assets/img/home/tiles/scb-tile-performance-settings.webp",
    title: "Performance & FPS",
    desc: "Fix stutter, crashes, and bad first impressions before you judge the game.",
    pill: "The game runs badly",
  },
  {
    href: "/should-you-buy-star-citizen/",
    img: "/assets/img/home/tiles/scb-tile-beginner-tips.webp",
    title: "Should You Buy?",
    desc: "Use a calm yes-or-no check if you are still deciding whether Star Citizen is for you.",
    pill: "I am still deciding",
  },
];
---

<BaseLayout
  title="Star Citizen Beginner Guide – Start Simple and Enjoy Your First Sessions"
  description="New to Star Citizen? Start here for clear beginner help: try Free Fly, choose one starter pack, fix performance issues, and make your first sessions much easier to enjoy."
  canonicalPath="/"
  stickyCtaLabel="Claim signup bonus (+50k UEC)"
  stickyCtaHref={referralLink}
  stickyCtaExternal={true}
 activeNav="home">
<link slot="head" rel="preload" as="image" href="/assets/img/home/scb-home-hero.webp" fetchpriority="high" />
  <FaqSchema items={homeFaqItems} />
  <main>

    <Breadcrumbs items={[{ label: 'Home', href: '/' }]} />
    <!-- ===================== HERO ===================== -->
    <section class="hero">
 <img
  class="hero__img"
  src="/assets/img/home/scb-home-hero.webp"
  alt="Star Citizen spaceship flying above a planet"
  loading="eager"
  fetchpriority="high"
  decoding="async"
  width="1536"
  height="1024"
/>
      <div class="hero__overlay"></div>

      <div class="hero__content">
        <div class="homeHero__content">
          <div style="max-width:720px; padding: 26px 0;">
            <h1 class="h1">Star Citizen Beginner Guide</h1>
          <p class="lead">New to Star Citizen? You do not need to figure out everything today. Pick one safe next step, avoid the mistakes that waste early sessions, and get into the game without turning the start into a project.</p>

            <div class="btnrow">
              <a class="btn primary" href="#first-session" data-scb-role="hero-start-route">Find your safest next step</a>
            </div>
          </div>
        </div>
      </div>

      <!-- ON THIS PAGE (integrated into hero on desktop) -->
      <OnThisPage
        variant="hero"
        title="On this page"
        items={[
          { label: "Quick answer", href: "#quick-answer" },
          { label: "Where to start", href: "#pick-your-path" },
          { label: "First 60 minutes", href: "#first-session" },
          { label: "Go deeper", href: "#guides" },
          { label: "Common mistakes", href: "#mistakes" },
          { label: "FAQ", href: "#faq" },
        ]}
      />
    </section>

    <!-- Referral banner (consistent with referral page) -->
    <ReferralBanner
      code={referralCode}
      bonus="50,000 UEC"
      ctaHref={referralLink}
      howItWorksHref={`${referralPage}#how-to-use`}
      sublineHtml="Optional, free, and easy to use during signup. It does not change your price — it just adds the signup bonus."
      ariaLabel="Referral bonus callout"
    />

    <!-- ===================== QUICK ANSWER ===================== -->
    <section id="quick-answer" class="section">
      <div class="card pad">
        <h2 class="section__title">Quick answer: start with one safe next step</h2>
        <p style="max-width:980px;">A good beginner start is simple: choose one path, solve that problem, and leave the rest for later. That is how you avoid fake difficulty in Star Citizen.</p>


        <div class="decisionGrid" style="margin-top:14px;">
          <div class="decisionCard">
            <div class="decisionCard__kicker">If you feel overwhelmed</div>
            <div class="decisionCard__title">Do not try to solve everything today</div>
            <p class="decisionCard__body">Pick one path only: try the game, decide whether to buy, choose one starter pack, fix performance, or run one simple money loop later.</p>
          </div>
          <div class="decisionCard">
            <div class="decisionCard__kicker">What usually goes wrong</div>
            <div class="decisionCard__title">Too many choices too early</div>
            <p class="decisionCard__body">Too many menus, too many ships, too many settings, and one rough session that makes the game feel harder than it really is.</p>
          </div>
          <div class="decisionCard">
            <div class="decisionCard__kicker">What actually helps</div>
            <div class="decisionCard__title">One calm session you can repeat</div>
            <p class="decisionCard__body">Your first goal is not profit or mastery. It is one clean session that teaches the basics and still feels manageable.</p>
          </div>
        </div>

        <div>
            <ul class="list">

              <li>Not sure if you should buy? Start with <a href="/free-fly/" data-scb-role="internal-free-fly-guide">Free Fly →</a> or take the <a href="/should-you-buy-star-citizen/">2‑minute buy check →</a>.</li>
              <li>Buying anyway? Buy <a href="/star-citizen-starter-packs/">one game package that fits your first hours →</a>. That is enough to start.</li>
              <li>After you buy, open My Hangar once, install through the launcher, and use a calm first-session checklist instead of figuring everything out live.</li>
              <li>If the game runs badly, do the <a href="/star-citizen-performance-guide/">10‑minute performance fix →</a> before you decide how it really feels.</li>
              <li>Need credits later? Use a <a href="/make-money-fast/">simple beginner money guide →</a> only after you have one stable loop.</li>
              <li>Already know you will create an account? Use the referral code during signup, then keep the rest simple until you have played a little.</li>
            </ul>

        <p class="muted" style="margin-top:10px;">Need a term explained? <a class="link" href="/satellites/glossary/">Open the beginner glossary</a>.</p>

          </div>
      </div>
    </section>

    <!-- ===================== PICK YOUR PATH ===================== -->
    <section id="pick-your-path" class="section">
      <div class="card pad">
        <h2 class="section__title">Pick your starting path (60 seconds)</h2>
        <p style="max-width: 980px;">
          Use the row that sounds most like you. Follow that page first and ignore the rest until you solve that one problem.
        </p>

        <p style="max-width: 980px; margin-top: 0;">These are the mistakes that create fake difficulty, wasted time, and bad first impressions. Fix them once and the start gets much easier.</p>

        <div class="tableWrap" style="margin-top:12px;">
          <table class="table">
            <thead>
              <tr>
                <th>Your situation</th>
                <th>Start here</th>
                <th>Why this path helps</th>
                <th>Next page</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th>I have not bought yet</th>
                <td>Try the game first</td>
                <td>You reduce risk and learn the feel of the game before spending money.</td>
                <td><a href="/free-fly/">Free Fly guide →</a></td>
              </tr>
              <tr>
                <th>I am deciding whether to buy</th>
                <td>Use a simple yes / no check</td>
                <td>You stop guessing and answer the only question that matters first: should you buy at all?</td>
                <td><a href="/should-you-buy-star-citizen/">Should you buy? →</a></td>
              </tr>
              <tr>
                <th>I am ready to buy</th>
                <td>Choose one starter pack once</td>
                <td>You avoid buying by looks alone and pick for your first real playstyle.</td>
                <td><a href="/star-citizen-starter-packs/">Starter packs →</a></td>
              </tr>
              <tr>
                <th>The game stutters or crashes</th>
                <td>Fix baseline performance first</td>
                <td>You get a fairer impression of the game and stop wasting time on random settings changes.</td>
                <td><a href="/star-citizen-performance-guide/">Performance guide →</a></td>
              </tr>
              <tr>
                <th>I need simple early credits</th>
                <td>Run one forgiving loop 2–3 times</td>
                <td>You build control first and let profit come from repeatable wins, not risky guesses.</td>
                <td><a href="/make-money-fast/">Make money fast →</a></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="btnrow" style="margin-top:14px; flex-wrap: wrap;">
          <a class="btn primary" href="#first-session">I just want a simple first session</a>
          <a class="btn ghost" href="/star-citizen-referral-code/">Referral code guide →</a>
        </div>
      </div>
    </section>

    <!-- ===================== FIRST SESSION ROUTE ===================== -->
    <section id="first-session" class="section">
      <div class="card pad">
        <h2 class="section__title">Your first session: one calm loop</h2>
        <p style="max-width: 980px;">
          Your first session does not need to be impressive. It only needs to be calm, understandable, and easy to repeat once.
        </p>

        <div class="tableWrap" style="margin-top:12px;">
          <table class="table">
            <thead>
              <tr>
                <th>Step</th>
                <th>Do</th>
                <th>Why</th>
                <th>Keep it simple</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th>1</th>
                <td>Spawn and set your home location</td>
                <td>Reduces friction on your next login</td>
                <td>Stay on the obvious station path and ignore side distractions</td>
              </tr>
              <tr>
                <th>2</th>
                <td>Claim your ship at the ASOP terminal</td>
                <td>Gets you moving fast</td>
                <td>Relog once if the terminal or UI clearly misbehaves</td>
              </tr>
              <tr>
                <th>3</th>
                <td>Run a simple courier/delivery contract</td>
                <td>Teaches travel + navigation with low risk</td>
                <td><a href="/make-money-fast/#do-this-now">Use the 10‑minute money guide →</a></td>
              </tr>
              <tr>
                <th>4</th>
                <td>Get your first payout and repeat 1–2 times</td>
                <td>Builds confidence and routine</td>
                <td>If the game runs badly, use the <a href="/star-citizen-performance-guide/#do-this-now">10‑minute fix →</a></td>
              </tr>
              <tr>
                <th>5</th>
                <td>Log out safely (don’t gamble your progress)</td>
                <td>Protects your first session experience</td>
                <td>Keep gear cheap until your loop feels routine</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="card" style="margin-top:14px;">
          <div class="pad">
            <div class="kicker"><span class="dot"></span> Verify</div>
            <p style="margin:0;">Try to complete one full contract loop in your first session. If that still feels rough, fix performance first and then try the same simple session again.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== GUIDES ===================== -->
    <section id="guides" class="section">
      <div class="card pad">
        <div class="kicker"><span class="dot"></span> Guide paths</div>
        <h2 class="section__title">Choose the path that matches your situation</h2>
        <p class="lead">These are not just topics. Each guide solves a common beginner problem. Open the one that sounds most like your situation right now.</p>
      </div>

      <div class="tiles">
        {tiles.map((t) => (
          <a class="tile" href={t.href}>
            <img
  class="tile__img"
  src={t.img}
  alt={t.title}
  loading="lazy"
  decoding="async"
  width="1024"
  height="1024"
/>
            <div class="tile__meta">
              <span class="tile__pill">{t.pill}</span>
              <h3 class="tile__title">{t.title}</h3>
              <p class="tile__desc">{t.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ===================== COMMON MISTAKES ===================== -->
    <section id="mistakes" class="section">
      <div class="card pad">
        <h2 class="section__title">The mistakes that make beginners quit too early</h2>

        <div class="tableWrap" style="margin-top:12px;">
          <table class="table">
            <thead>
              <tr>
                <th>Mistake</th>
                <th>What happens</th>
                <th>Fix (exact)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th>Trying to learn everything at once</th>
                <td>Overwhelm, random choices, slow progress</td>
                <td>Pick one loop only, repeat it 2–3 times, then expand later. Start here: <a href="/make-money-fast/">Money loop guide →</a></td>
              </tr>
              <tr>
                <th>Judging the game while it stutters</th>
                <td>Bad first impression, crashes, wasted time</td>
                <td>Fix performance before you evaluate the game. Use the <a href="/star-citizen-performance-guide/">performance guide →</a></td>
              </tr>
              <tr>
                <th>Buying extra ships early</th>
                <td>Regret spend, still no clear playstyle</td>
                <td>Start with one starter pack and upgrade only after consistent play. Use <a href="/star-citizen-starter-packs/">Starter packs →</a></td>
              </tr>
              <tr>
                <th>Skipping a structured Free Fly test</th>
                <td>Testing the wrong things and missing the fun</td>
                <td>Use the Free Fly checklist and first-session plan together: <a href="/free-fly/">Free Fly guide →</a></td>
              </tr>
              <tr>
                <th>Missing the signup bonus window</th>
                <td>No extra starting credits on a new account</td>
                <td>Enter a referral code during account creation. Do it here: <a href="+'''{referralLink}'''+" target="_blank" rel="nofollow noopener noreferrer">Create account + claim bonus →</a></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ===================== FAQ ===================== -->
    
    <section id="related-answers" class="section alt">
      <div class="container">
        <h2 class="h2">Useful follow-ups</h2>
        <p class="muted" style="margin:0 0 12px; max-width: 860px;">Open one of these if you still have a specific problem after choosing your main path.</p>
        <ul class="bullets">
            <li><a href="/satellites/first-session/">First session checklist (easy first hour)</a></li>
            <li><a href="/satellites/fix-stuttering/">Fix stuttering (SSD/RAM checklist)</a></li>
            <li><a href="/satellites/where-to-enter-referral-code/">Where to enter the referral code</a></li>
            <li><a href="/satellites/glossary/">Beginner glossary (key terms)</a></li>
        </ul>
      </div>
    </section>

<section id="faq" class="section">
      <div class="card pad">
        <h2 class="section__title">FAQ</h2>
        <p class="muted" style="margin-top:0; max-width: 860px;">These are the quick beginner questions that tend to matter before the game starts to feel comfortable.</p>
        <div class="faq" style="margin-top:12px;">
          <details class="faq__item">
            <summary class="faq__q">Can I try Star Citizen without buying?</summary>
            <div class="faq__a">Yes. Use <a href="/free-fly/" data-scb-role="internal-free-fly-guide">Free Fly →</a> to test the game first and follow a structured first session plan.</div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">What’s the smartest first thing to do in-game?</summary>
            <div class="faq__a">Run one simple contract loop (delivery/courier) and repeat it 2–3 times. It teaches travel, UI, and pays you without heavy risk.</div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">Do I need a strong PC?</summary>
            <div class="faq__a">You need a solid baseline and the right settings. If the game stutters, fix performance first: <a href="/star-citizen-performance-guide/">Performance guide →</a></div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">What starter pack should I buy?</summary>
            <div class="faq__a">Pick a pack that matches your first loop and buy the minimum. Use this: <a href="/star-citizen-starter-packs/">Starter packs guide →</a></div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">Is the referral code mandatory?</summary>
            <div class="faq__a">No. It’s optional and doesn’t change your price. If you want the free starting credits, enter it during signup: <a href="/star-citizen-referral-code/">how it works →</a></div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">Can I use these guides during Free Fly?</summary>
            <div class="faq__a">Yes. The same first-session checklist and money tips still help — you are just trying the game before buying.</div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">How do I make money fast as a beginner?</summary>
            <div class="faq__a">Start with simple delivery loops, then branch out into bounties or mining. Full guide here: <a href="/make-money-fast/">Make money fast →</a></div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">What should I avoid in my first hours?</summary>
            <div class="faq__a">Avoid all-in trading, expensive gear runs, and changing 20 settings at once. Build one repeatable loop first.</div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">I’m overwhelmed. What is the easiest way to start?</summary>
            <div class="faq__a">Follow the <a href="#first-session">First 60 minutes section</a> on this page and ignore the rest until you finish one full loop.</div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">Where do I enter the referral code?</summary>
            <div class="faq__a">On the RSI signup page during account creation. If you want it handy right here, copy <button class="codePill js-copyCode" type="button" data-copy-referral={referralCode} aria-label={`Copy referral code ${referralCode} to clipboard`} title="Click to copy">{referralCode}</button> and paste it into the field labeled “Referral Code (optional)”.</div>
          </details>
        </div>

        <div class="btnrow" style="margin-top:14px; flex-wrap: wrap;">
          <a class="btn primary" href="#first-session">Create account + claim signup bonus</a>
          <a class="btn ghost" href="/star-citizen-referral-code/">Referral code guide →</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>










