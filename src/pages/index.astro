---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReferralBanner from "../components/ReferralBanner.astro";
import OnThisPage from "../components/OnThisPage.astro";
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqSchema from "../components/FaqSchema.astro";
import { REFERRAL_CODE, REFERRAL_LINK, REFERRAL_INFO_PATH, REFERRAL_BONUS_UEC, FLY_FREE_URL } from "../config/site";

const referralCode = REFERRAL_CODE;
const referralLink = REFERRAL_LINK;
const referralPage = REFERRAL_INFO_PATH;

const homeFaqItems = [
  { q: "Can I try Star Citizen without buying?", a: "Yes. Use Free Fly if you want to test the game before you spend money." },
  { q: "Do I need a strong PC?", a: "You need a reasonable baseline and the right settings. If the game feels rough, fix performance first." },
  { q: "What should I buy first?", a: "One starter pack is enough. Start with a beginner-friendly game package, not a bigger ship." },
  { q: "Is the referral code mandatory?", a: "No. It is optional and does not change your price. Use it during account creation if you want the signup bonus." },
  { q: "Where do I enter the referral code?", a: "Enter it on the RSI signup page during account creation. The referral guide shows the exact field." },
  { q: "I’m overwhelmed. What is the easiest way to start?", a: "Pick one path from the main hub, then follow the first calm hour plan. You do not need to solve everything today." },
];

const tiles = [
  {
    href: "/free-fly/",
    img: "/assets/img/home/tiles/star-citizen-free-fly-tile.webp",
    title: "Try Star Citizen before you buy",
    desc: "Use Free Fly to test performance, controls, and general feel before you spend money.",
    pill: "Try for free",
  },
  {
    href: "/should-you-buy-star-citizen/",
    img: "/assets/img/home/tiles/scb-tile-should-you-buy.webp",
    title: "Should you buy Star Citizen?",
    desc: "Use a calm buy-or-wait check if you are not sure whether the game fits you yet.",
    pill: "Buy or wait",
  },
  {
    href: "/star-citizen-starter-packs/",
    img: "/assets/img/home/tiles/scb-tile-starter-pack.webp",
    title: "Choose one starter pack",
    desc: "Compare the beginner-safe game packages and ignore bigger ships for now.",
    pill: "Starter packs",
  },
  {
    href: "/star-citizen-performance-guide/",
    img: "/assets/img/home/tiles/scb-tile-performance-settings.webp",
    title: "Fix stutter, crashes, and low FPS",
    desc: "Remove fake difficulty before you decide how the game really feels.",
    pill: "Performance help",
  },
  {
    href: "/beginner-tips/",
    img: "/assets/img/home/tiles/scb-tile-beginner-tips.webp",
    title: "What to do in your first sessions",
    desc: "Use one calm beginner routine so your first hours feel manageable instead of messy.",
    pill: "Start simple",
  },
  {
    href: "/make-money-fast/",
    img: "/assets/img/home/tiles/scb-tile-make-money-fast.webp",
    title: "How to earn easy beginner credits",
    desc: "Start with forgiving money loops after the basics feel stable.",
    pill: "Beginner money",
  },
];

const specificHelp = [
  {
    href: "/first-session/",
    title: "Use the first-session checklist",
    desc: "Open a short checklist if you want one calm, structured first hour.",
  },
  {
    href: "/fix-stuttering/",
    title: "Fix stuttering before you judge the game",
    desc: "Check the most common beginner performance problems first.",
  },
  {
    href: "/where-to-enter-referral-code/",
    title: "See where to enter the referral code",
    desc: "Use the quick visual guide if you do not want to miss the signup field.",
  },
];
---

<BaseLayout
  title="Star Citizen Beginner Hub: Find Your Safest Next Step"
  description="New to Star Citizen? Use this beginner hub to choose your safest next step: try Free Fly, decide whether to buy, choose a starter pack, fix performance, or start your first sessions."
  canonicalPath="/"
  stickyCtaLabel="Create account + claim bonus"
  stickyCtaHref={referralLink}
  stickyCtaExternal={true}
 activeNav="home">
<link slot="head" rel="preload" as="image" href="/assets/img/home/scb-home-hero.webp" fetchpriority="high" />
  <FaqSchema items={homeFaqItems} />
  <main>

    <Breadcrumbs items={[{ label: 'Home', href: '/' }]} />
    <!-- ===================== HERO ===================== -->
    <section class="hero">
 <img
  class="hero__img"
  src="/assets/img/home/scb-home-hero.webp"
  alt="Star Citizen spaceship flying above a planet"
  loading="eager"
  fetchpriority="high"
  decoding="async"
  width="1536"
  height="1024"
/>
      <div class="hero__overlay"></div>

      <div class="hero__content">
        <div class="homeHero__content">
          <div>
            <h1 class="h1">Star Citizen Beginner Guide</h1>
          <p class="lead">You do not need to solve everything today. Pick the one path that matches your situation, go to that page, and let the rest wait until you need it.</p>

            <div class="btnrow">
              <a class="btn primary" href="#start-here" data-scb-role="hero-start-route">Find your safest next step</a>
            </div>
          </div>
        </div>
      </div>

      <!-- ON THIS PAGE (integrated into hero on desktop) -->
      <OnThisPage
        variant="hero"
        title="On this page"
        items={[
          { label: "Start here", href: "#start-here" },
          { label: "First calm hour", href: "#first-session" },
          { label: "What goes wrong", href: "#mistakes" },
          { label: "Specific help", href: "#specific-help" },
          { label: "FAQ", href: "#faq" },
        ]}
      />
    </section>

    <!-- Referral banner (consistent with referral page) -->
    <ReferralBanner
      code={referralCode}
      bonus="50,000 UEC"
      ctaHref={referralLink}
      howItWorksHref={`${referralPage}#how-to-use`}
      sublineHtml="Optional and easy to use during signup. It does not change your price. It simply adds the signup bonus."
      ariaLabel="Referral bonus callout"
    />
    <!-- ===================== START HERE ===================== -->
    <section id="start-here" class="section">
      <div class="card pad">
        <h2 class="section__title">Choose the one page that matches your situation</h2>
        <p style="max-width:980px;">These six pages are the main starting paths. Pick the one problem in front of you first.</p>
      </div>

      <div class="tiles" style="margin-top:14px;">
        {tiles.map((t) => (
          <a class="tile" href={t.href}>
            <img
              class="tile__img"
              src={t.img}
              alt={t.title}
              loading="lazy"
              decoding="async"
              width="1024"
              height="1024"
            />
            <div class="tile__meta">
              <span class="tile__pill">{t.pill}</span>
              <h3 class="tile__title">{t.title}</h3>
              <p class="tile__desc">{t.desc}</p>
            </div>
          </a>
        ))}
      </div>

      <p class="muted" style="margin-top:12px;">These are path choices, not a reading list. Pick one and let the rest wait.</p>
    </section>

    <!-- ===================== FIRST SESSION ROUTE ===================== -->
    <section id="first-session" class="section">
      <div class="card pad">
        <h2 class="section__title">Here is your first calm hour</h2>
        <p style="max-width:980px;">Do one clean loop, stop, and call that a win. Day one does not need to be long or impressive.</p>

        <div class="decisionGrid" style="margin-top:14px;">
          <div class="decisionCard">
            <div class="decisionCard__kicker">Step 1</div>
            <div class="decisionCard__title">Spawn, set your home, and claim your ship</div>
            <p class="decisionCard__body">This removes the first layer of friction and gets you moving without panic.</p>
          </div>
          <div class="decisionCard">
            <div class="decisionCard__kicker">Step 2</div>
            <div class="decisionCard__title">Run one simple courier or delivery contract</div>
            <p class="decisionCard__body">It teaches travel, mission flow, and basic menus with very low risk.</p>
          </div>
          <div class="decisionCard">
            <div class="decisionCard__kicker">Step 3</div>
            <div class="decisionCard__title">Stop after one clean loop and repeat it later</div>
            <p class="decisionCard__body">That is enough for day one. Repeatability matters more than squeezing in everything at once.</p>
          </div>
        </div>

        <p class="muted" style="margin-top:12px;">If this still feels rough, fix performance first and then try the same simple session again.</p>

        <div class="btnrow" style="margin-top:12px; flex-wrap: wrap;">
          <a class="btn ghost" href="/beginner-tips/">Open beginner tips →</a>
          <a class="btn ghost" href="/first-session/">Use the first-session checklist →</a>
        </div>
      </div>
    </section>

    <!-- ===================== WHAT GOES WRONG ===================== -->
    <section id="mistakes" class="section">
      <div class="card pad">
        <h2 class="section__title">What usually goes wrong at the start</h2>
        <p style="max-width:980px;">A rough first session usually comes from the wrong order, not from you. These are the mistakes that make the start feel harder than it should.</p>

        <div class="decisionGrid" style="margin-top:14px;">
          <div class="decisionCard">
            <div class="decisionCard__kicker">What trips people up</div>
            <div class="decisionCard__title">Trying to learn everything at once</div>
            <p class="decisionCard__body">Too many menus, contracts, locations, and controls at the same time turns a simple start into a messy one.</p>
          </div>
          <div class="decisionCard">
            <div class="decisionCard__kicker">What causes bad first impressions</div>
            <div class="decisionCard__title">Judging the game from one rough session</div>
            <p class="decisionCard__body">Bad performance, a rough spawn, or one chaotic session can make the game feel worse than it normally does.</p>
          </div>
          <div class="decisionCard">
            <div class="decisionCard__kicker">What wastes money early</div>
            <div class="decisionCard__title">Buying extra ships too early</div>
            <p class="decisionCard__body">You do not need more ships to fix a rough start. One sensible package is enough until your routine feels stable.</p>
          </div>
        </div>

        <p class="muted" style="margin-top:12px;">One easy thing not to miss: if you are creating a new account, add the referral code during signup so you do not have to think about it later.</p>
      </div>
    </section>

    <!-- ===================== SPECIFIC HELP ===================== -->
    <section id="specific-help" class="section">
      <div class="card pad">
        <h2 class="section__title">If one smaller blocker is still in the way</h2>
        <p style="max-width:980px;">Use one smaller answer only after your main path is already clear.</p>

        <div class="decisionGrid" style="margin-top:14px;">
          {specificHelp.map((item) => (
            <a class="decisionCard" href={item.href} style="text-decoration:none; color:inherit;">
              <div class="decisionCard__kicker">Specific help</div>
              <div class="decisionCard__title">{item.title}</div>
              <p class="decisionCard__body">{item.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ===================== FAQ ===================== -->

<section id="faq" class="section">
      <div class="card pad">
        <h2 class="section__title">FAQ</h2>
        <p class="muted" style="margin-top:8px; max-width:980px;">Use these quick answers if one basic beginner question is still in the way.</p>
        <div class="faq" style="margin-top:12px;">
          <details class="faq__item">
            <summary class="faq__q">Can I try Star Citizen without buying?</summary>
            <div class="faq__a">Yes. Use <a href="/free-fly/" data-scb-role="internal-free-fly-guide">Free Fly →</a> if you want to test the game before you spend money.</div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">Do I need a strong PC?</summary>
            <div class="faq__a">You need a reasonable baseline and the right settings. If the game feels rough, start with the <a href="/star-citizen-performance-guide/">Performance guide →</a>.</div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">What should I buy first?</summary>
            <div class="faq__a">One sensible starter pack is enough. Use the <a href="/star-citizen-starter-packs/">Starter packs page →</a> if you are ready to compare game packages.</div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">Is the referral code mandatory?</summary>
            <div class="faq__a">No. It is optional and does not change your price. Use it during signup if you want the starting bonus: <a href="/star-citizen-referral-code/">Referral guide →</a></div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">I’m overwhelmed. What is the easiest way to start?</summary>
            <div class="faq__a">Pick one path from the main hub, then follow the <a href="#first-session">first calm hour</a>. You do not need to solve everything today.</div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">Where do I enter the referral code?</summary>
            <div class="faq__a">On the RSI signup page during account creation. If you want it handy right here, copy <button class="codePill js-copyCode" type="button" data-copy-referral={referralCode} aria-label={`Copy referral code ${referralCode} to clipboard`} title="Click to copy">{referralCode}</button> and paste it into the field labeled <b>“Referral Code (optional)”</b>.</div>
          </details>
        </div></div>

        <div class="btnrow" style="margin-top:14px; flex-wrap: wrap;">
          <a class="btn primary" href={referralLink} target="_blank" rel="nofollow noopener noreferrer" data-scb-role="referral-signup">Create account + claim bonus</a>
          <a class="btn ghost" href="/star-citizen-referral-code/">See where the referral code goes →</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>










