---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReferralBanner from "../components/ReferralBanner.astro";
import OnThisPage from "../components/OnThisPage.astro";
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqSchema from "../components/FaqSchema.astro";
import { REFERRAL_CODE, REFERRAL_LINK, REFERRAL_INFO_PATH, REFERRAL_BONUS_UEC, FLY_FREE_URL } from "../config/site";

const referralCode = REFERRAL_CODE;
const referralLink = REFERRAL_LINK;
const referralPage = REFERRAL_INFO_PATH;

const homeFaqItems = [
  { q: "Can I try Star Citizen without buying?", a: "Yes. Use Free Fly to test the game first and follow a simple first-session plan." },
  { q: "What’s the smartest first thing to do in-game?", a: "Run one simple contract and repeat it once or twice. It teaches travel, menus, and mission flow without making your first session feel chaotic." },
  { q: "Do I need a strong PC?", a: "You need a solid baseline and the right settings. If the game stutters, fix performance first with a targeted performance guide." },
  { q: "What starter pack should I buy?", a: "Pick the cheapest game package that fits the way you want to start. One game package is enough to begin, and you can change direction later." },
  { q: "Do I need a subscription to play?", a: "No. A subscription is optional. To play outside Free Fly, you just need one game package on your account." },
  { q: "What happens right after I buy?", a: "Open My Hangar once to make sure your package is there, then download the launcher, install the game, and use a simple first-session plan." },
  { q: "Is the referral code mandatory?", a: "No. It is optional and does not change your price. If you want the signup bonus, enter it during account creation." },
  { q: "Where do I enter the referral code?", a: "On the RSI signup page during account creation. The referral guide shows the exact place." },
];

const tiles = [
  {
    href: "/free-fly/",
    img: "/assets/img/home/tiles/star-citizen-free-fly-tile.webp",
    title: "Free Fly",
    desc: "Try Star Citizen first and learn what Free Fly can and cannot tell you.",
    pill: "Try first",
  },
  {
    href: "/should-you-buy-star-citizen/",
    img: "/assets/img/home/tiles/scb-tile-beginner-tips.webp",
    title: "Should You Buy?",
    desc: "Use a calm yes-or-no check if you are still deciding whether the game is for you.",
    pill: "Decide first",
  },
  {
    href: "/star-citizen-starter-packs/",
    img: "/assets/img/home/tiles/scb-tile-starter-pack.webp",
    title: "Starter Packs",
    desc: "Choose one sensible starter pack without overbuying or chasing the wrong thing.",
    pill: "Buy smart",
  },
  {
    href: "/beginner-tips/",
    img: "/assets/img/home/tiles/scb-tile-beginner-tips.webp",
    title: "Beginner Tips",
    desc: "Start simple, avoid fake difficulty, and build one repeatable beginner routine.",
    pill: "Start simple",
  },
  {
    href: "/star-citizen-performance-guide/",
    img: "/assets/img/home/tiles/scb-tile-performance-settings.webp",
    title: "Performance & FPS",
    desc: "Fix stutter, crashes, and bad first impressions before you judge the game.",
    pill: "Fix the game",
  },
  {
    href: "/make-money-fast/",
    img: "/assets/img/home/tiles/scb-tile-make-money-fast.webp",
    title: "Make Money Fast",
    desc: "Use one forgiving early money loop after your first session feels stable.",
    pill: "Earn later",
  },
];
---

<BaseLayout
  title="Star Citizen Beginner Guide – Start Simple and Enjoy Your First Sessions"
  description="New to Star Citizen? Start here for clear beginner help: try Free Fly, choose one starter pack, fix performance issues, and make your first sessions much easier to enjoy."
  canonicalPath="/"
  stickyCtaLabel="Claim signup bonus (+50k UEC)"
  stickyCtaHref={referralLink}
  stickyCtaExternal={true}
 activeNav="home">
<link slot="head" rel="preload" as="image" href="/assets/img/home/scb-home-hero.webp" fetchpriority="high" />
  <FaqSchema items={homeFaqItems} />
  <main>

    <Breadcrumbs items={[{ label: 'Home', href: '/' }]} />
    <!-- ===================== HERO ===================== -->
    <section class="hero">
 <img
  class="hero__img"
  src="/assets/img/home/scb-home-hero.webp"
  alt="Star Citizen spaceship flying above a planet"
  loading="eager"
  fetchpriority="high"
  decoding="async"
  width="1536"
  height="1024"
/>
      <div class="hero__overlay"></div>

      <div class="hero__content">
        <div class="homeHero__content">
          <div style="max-width:720px; padding: 26px 0;">
            <h1 class="h1">Star Citizen Beginner Guide</h1>
          <p class="lead">New to Star Citizen? You do not need to solve everything today. Pick one safe next step, avoid the mistakes that create fake difficulty, and let the rest wait until the basics feel easier.</p>

            <div class="btnrow">
              <a class="btn primary" href="#situation" data-scb-role="hero-start-route">Find your safest next step</a>
            </div>
          </div>
        </div>
      </div>

      <!-- ON THIS PAGE (integrated into hero on desktop) -->
      <OnThisPage
        variant="hero"
        title="On this page"
        items={[
          { label: "Start here", href: "#situation" },
          { label: "Mistakes", href: "#mistakes" },
          { label: "First hour", href: "#first-hour" },
          { label: "Specific help", href: "#specific-help" },
          { label: "FAQ", href: "#faq" },
        ]}
      />
    </section>

    <!-- ===================== PICK YOUR SITUATION ===================== -->
    <section id="situation" class="section">
      <div class="card pad">
        <h2 class="section__title">Choose your safest starting path</h2>
        <p style="max-width:860px;">Start with the main page that matches your situation best. Pick one path, ignore the rest for now, and let the start feel easier before you stack more decisions on top.</p>

        <div class="decisionGrid" style="margin-top:14px;">
          <a class="decisionCard" href="/free-fly/" style="text-decoration:none; color:inherit; display:block;">
            <div class="decisionCard__kicker">Try first</div>
            <div class="decisionCard__title">Try the game before you buy</div>
            <p class="decisionCard__body">Use Free Fly to test the game without spending money yet.</p>
          </a>
          <a class="decisionCard" href="/should-you-buy-star-citizen/" style="text-decoration:none; color:inherit; display:block;">
            <div class="decisionCard__kicker">Decide first</div>
            <div class="decisionCard__title">Decide if Star Citizen is worth it for you</div>
            <p class="decisionCard__body">Use one calm reality check before you think about packs, upgrades, or hype.</p>
          </a>
          <a class="decisionCard" href="/star-citizen-starter-packs/" style="text-decoration:none; color:inherit; display:block;">
            <div class="decisionCard__kicker">Buy smart</div>
            <div class="decisionCard__title">Choose one sensible starter pack</div>
            <p class="decisionCard__body">Start with one practical package and leave bigger ships for later.</p>
          </a>
          <a class="decisionCard" href="/star-citizen-performance-guide/" style="text-decoration:none; color:inherit; display:block;">
            <div class="decisionCard__kicker">Fix the game</div>
            <div class="decisionCard__title">Fix stutter, crashes, and bad first impressions</div>
            <p class="decisionCard__body">Build a clean baseline before you judge how the game really feels.</p>
          </a>
          <a class="decisionCard" href="/beginner-tips/" style="text-decoration:none; color:inherit; display:block;">
            <div class="decisionCard__kicker">Start simple</div>
            <div class="decisionCard__title">Start your first sessions safely</div>
            <p class="decisionCard__body">Use one calm beginner routine instead of trying to learn everything today.</p>
          </a>
          <a class="decisionCard" href="/make-money-fast/" style="text-decoration:none; color:inherit; display:block;">
            <div class="decisionCard__kicker">Earn later</div>
            <div class="decisionCard__title">Build easy beginner credits later</div>
            <p class="decisionCard__body">Use a simple early loop after your basics feel stable.</p>
          </a>
        </div>

        <p class="muted" style="margin:14px 0 0; max-width:860px;">One clear path beats six half-started plans. Pick the problem that is blocking you most and let the rest wait.</p>
      </div>
    </section>

    <!-- Referral banner (kept secondary to the situation hub) -->
    <ReferralBanner
      code={referralCode}
      bonus="50,000 UEC"
      ctaHref={referralLink}
      howItWorksHref={`${referralPage}#how-to-use`}
      sublineHtml="Optional, free, and easy to use during signup. It does not change your price — it only adds the signup bonus if you want it."
      ariaLabel="Referral bonus callout"
    />

    <!-- ===================== COMMON MISTAKES ===================== -->
    <section id="mistakes" class="section">
      <div class="card pad">
        <div class="kicker"><span class="dot"></span> Trust block</div>
        <h2 class="section__title">The mistakes that make beginners quit too early</h2>
        <p style="max-width:920px;">Most bad starts come from the wrong order, not from being bad at the game. Fix these first and the whole start usually feels easier.</p>

        <div class="decisionGrid" style="margin-top:14px;">
          <div class="decisionCard">
            <div class="decisionCard__title">Trying to learn everything at once</div>
            <p class="decisionCard__body">Too many goals create random choices, wasted time, and a start that never feels settled.</p>
            <p class="muted" style="margin:10px 0 0;">Fix: run one safe loop only, then repeat it. <a href="/beginner-tips/">Beginner tips →</a></p>
          </div>
          <div class="decisionCard">
            <div class="decisionCard__title">Judging the game from one rough session</div>
            <p class="decisionCard__body">A bad frame-time, crowded server, or awkward spawn can make the whole game feel worse than it really is.</p>
            <p class="muted" style="margin:10px 0 0;">Fix: check the <a href="/star-citizen-performance-guide/">performance guide →</a> before you decide what the game actually feels like.</p>
          </div>
          <div class="decisionCard">
            <div class="decisionCard__title">Buying extra ships too early</div>
            <p class="decisionCard__body">Extra ships rarely fix the real early-game problem. They usually just lock money in before you know your playstyle.</p>
            <p class="muted" style="margin:10px 0 0;">Fix: start with one pack and leave upgrades for later. <a href="/star-citizen-starter-packs/">Starter packs →</a></p>
          </div>
        </div>

        <p class="muted" style="margin:14px 0 0; max-width:900px;">One easy thing not to miss: if you want the signup bonus, enter the referral code during account creation. <a href={referralLink} target="_blank" rel="nofollow noopener noreferrer">Create account + claim bonus →</a></p>
      </div>
    </section>

    <!-- ===================== FIRST HOUR ===================== -->
    <section id="first-hour" class="section">
      <div class="card pad">
        <h2 class="section__title">What to do in your first hour</h2>
        <p style="max-width: 920px;">This is enough for day one: get your spawn working, run one safe contract, and end the session cleanly.</p>

        <div class="decisionGrid" style="margin-top:14px;">
          <div class="decisionCard">
            <div class="decisionCard__kicker">1</div>
            <div class="decisionCard__title">Set home and claim your ship</div>
            <p class="decisionCard__body">Wake up, move through the station, use the ASOP terminal, and find your ship without panic.</p>
          </div>
          <div class="decisionCard">
            <div class="decisionCard__kicker">2</div>
            <div class="decisionCard__title">Run one simple delivery contract</div>
            <p class="decisionCard__body">It teaches travel, basic interaction, and mission flow with much less risk than trying everything at once.</p>
          </div>
          <div class="decisionCard">
            <div class="decisionCard__kicker">3</div>
            <div class="decisionCard__title">Stop after one clean loop</div>
            <p class="decisionCard__body">A calm finish is enough for today. Repeat later instead of forcing a messy second plan.</p>
          </div>
        </div>

        <p class="muted" style="margin:14px 0 0; max-width:900px;">Keep your gear cheap, your route obvious, and your expectations small. If the game still feels rough after one clean loop, fix performance first and then try the same simple session again.</p>

        <div class="btnrow" style="margin-top:14px; flex-wrap: wrap;">
          <a class="btn primary" href="/beginner-tips/">Open beginner tips</a>
          <a class="btn ghost" href="/satellites/first-session/">First session checklist →</a>
        </div>
      </div>
    </section>

    <!-- ===================== SPECIFIC HELP ===================== -->
    <section id="specific-help" class="section">
      <div class="card pad">
        <div class="kicker"><span class="dot"></span> Specific help</div>
        <h2 class="section__title">If one specific problem is still blocking you</h2>
        <p class="lead">You already chose your main path above. Use one of these only if a smaller problem is still getting in the way.</p>

        <div class="decisionGrid" style="margin-top:14px;">
          <a class="decisionCard" href="/satellites/first-session/" style="text-decoration:none; color:inherit; display:block;">
            <div class="decisionCard__kicker">Session help</div>
            <div class="decisionCard__title">Use a simple first-session checklist</div>
            <p class="decisionCard__body">Follow one calm hour without guessing what to do next.</p>
          </a>
          <a class="decisionCard" href="/satellites/fix-stuttering/" style="text-decoration:none; color:inherit; display:block;">
            <div class="decisionCard__kicker">Performance fix</div>
            <div class="decisionCard__title">Fix stuttering before you judge the game</div>
            <p class="decisionCard__body">Use the SSD, RAM, and baseline checklist that solves the most common beginner stutter problems.</p>
          </a>
          <a class="decisionCard" href="/satellites/where-to-enter-referral-code/" style="text-decoration:none; color:inherit; display:block;">
            <div class="decisionCard__kicker">Signup help</div>
            <div class="decisionCard__title">See exactly where to enter the referral code</div>
            <p class="decisionCard__body">Use the field correctly during account creation and avoid missing the signup bonus by mistake.</p>
          </a>
          <a class="decisionCard" href="/referral-bonus-checklist/" style="text-decoration:none; color:inherit; display:block;">
            <div class="decisionCard__kicker">Bonus checklist</div>
            <div class="decisionCard__title">Double-check the referral bonus steps</div>
            <p class="decisionCard__body">Use a short checklist if you want to verify the bonus path before you create your account.</p>
          </a>
        </div>
      </div>
    </section>

<section id="faq" class="section">
      <div class="card pad">
        <h2 class="section__title">FAQ</h2>
        <p class="muted" style="margin-top:0; max-width: 860px;">These are the beginner questions that matter most before the game starts to feel understandable.</p>
        <div class="faq" style="margin-top:12px;">
          <details class="faq__item">
            <summary class="faq__q">Can I try Star Citizen without buying?</summary>
            <div class="faq__a">Yes. Use <a href="/free-fly/" data-scb-role="internal-free-fly-guide">Free Fly →</a> to test the game first and follow a structured first session plan.</div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">What’s the smartest first thing to do in-game?</summary>
            <div class="faq__a">Run one simple contract loop (delivery/courier) and repeat it 2–3 times. It teaches travel, UI, and pays you without heavy risk.</div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">Do I need a strong PC?</summary>
            <div class="faq__a">You need a solid baseline and the right settings. If the game stutters, fix performance first: <a href="/star-citizen-performance-guide/">Performance guide →</a></div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">What starter pack should I buy?</summary>
            <div class="faq__a">Pick a pack that matches your first loop and buy the minimum. Use this: <a href="/star-citizen-starter-packs/">Starter packs guide →</a></div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">Is the referral code mandatory?</summary>
            <div class="faq__a">No. It’s optional and doesn’t change your price. If you want the free starting credits, enter it during signup: <a href="/star-citizen-referral-code/">how it works →</a></div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">Can I use these guides during Free Fly?</summary>
            <div class="faq__a">Yes. The same first-session checklist and money tips still help — you are just trying the game before buying.</div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">How do I make money fast as a beginner?</summary>
            <div class="faq__a">Start with simple delivery loops, then branch out into bounties or mining. Full guide here: <a href="/make-money-fast/">Make money fast →</a></div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">What should I avoid in my first hours?</summary>
            <div class="faq__a">Avoid all-in trading, expensive gear runs, and changing 20 settings at once. Build one repeatable loop first.</div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">I’m overwhelmed. What is the easiest way to start?</summary>
            <div class="faq__a">Follow the <a href="#first-hour">first-hour section</a> on this page and ignore the rest until you finish one full loop.</div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">Where do I enter the referral code?</summary>
            <div class="faq__a">On the RSI signup page during account creation. If you want it handy right here, copy <button class="codePill js-copyCode" type="button" data-copy-referral={referralCode} aria-label={`Copy referral code ${referralCode} to clipboard`} title="Click to copy">{referralCode}</button> and paste it into the field labeled “Referral Code (optional)”.</div>
          </details>
        </div>

        <div class="btnrow" style="margin-top:14px; flex-wrap: wrap;">
          <a class="btn primary" href={referralLink} target="_blank" rel="nofollow noopener noreferrer">Create account and claim signup bonus</a>
          <a class="btn ghost" href="/star-citizen-referral-code/">See the referral guide →</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>










