---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReferralBanner from "../../components/ReferralBanner.astro";
import OnThisPage from "../../components/OnThisPage.astro";
import FaqSchema from "../../components/FaqSchema.astro";
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { REFERRAL_CODE, REFERRAL_LINK, REFERRAL_BONUS_UEC, FREE_FLY_HUB_PATH } from "../../config/site";

const referralCode = REFERRAL_CODE;
const referralLink = REFERRAL_LINK;
const heroImg = "/assets/img/free-fly/star-citizen-free-fly-hero.webp";

const tocItems = [
  { id: "quick-answer", label: "Quick answer" },
  { id: "do-this-now", label: "Do this now" },
  { id: "common-mistakes", label: "What goes wrong" },
  { id: "next-steps", label: "Next steps" },
  { id: "faq", label: "FAQ" }
];

const faqItems = [
  { q: "Do regions matter during Free Fly?", a: "Often yes. Start with the closest region, then retest with the next closest if the session is rough." },
  { q: "Can I completely avoid queues and lag?", a: "No. You cannot control global event load. You can only improve your odds by choosing calmer conditions and restarting bad sessions early." },
  { q: "What is the cleanest first activity for timing tests?", a: "A short courier or delivery loop is still the best timing test because it is easy to repeat after each change." },
  { q: "Should I delay the whole trial if the event feels chaotic?", a: "Sometimes yes. One calmer session later tells you more than forcing the worst moment and deciding from that." },
  { q: "What if every time feels rough?", a: "Then it stops being a timing-only problem and you should move to the server-lag page or the performance guide." }
];
---

<BaseLayout
  title="Best Time to Play Free Fly: Avoid the Worst Chaos | Star Citizen Beginner"
  description="Pick a better time to play Free Fly so your first Star Citizen test is less shaped by queues, crowded hubs, and bad event timing."
  canonicalPath="/best-time-to-play-free-fly/"
  pageType="satellite"
  pageTier="satellite"
  ogImage={heroImg}
  ogImageAlt="Best time to play Free Fly"
  stickyCtaLabel="Open full Free Fly guide"
  stickyCtaHref={FREE_FLY_HUB_PATH}
  activeNav="free-fly"
>
  <main>
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Free Fly', href: FREE_FLY_HUB_PATH }, { label: 'Best time to play Free Fly', href: '/best-time-to-play-free-fly/' }]} />

    <section class="hero guideHero">
      <img
        class="hero__img"
        src={heroImg}
        alt="Best time to play Free Fly"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1536"
        height="1024"
      />
      <div class="hero__overlay"></div>

      <div class="hero__content">
        <div class="guideHero__content">
          <div class="kicker"><span class="dot"></span> Timing</div>
          <h1 class="h1">Best time to play Free Fly</h1>
          <p class="lead" style="max-width: 820px;">This page only solves the timing question: how to avoid the worst Free Fly chaos so your first test feels fairer and less dominated by queues, crowded hubs, and overloaded sessions.</p>

          <div class="hero__cta">
            <a class="btn primary" href="#quick-answer">Start here</a>
          </div>
        </div>

        <OnThisPage variant="hero" title="On this page" items={tocItems} />
      </div>
    </section>

    <ReferralBanner
      code={referralCode}
      bonus={`${REFERRAL_BONUS_UEC} UEC`}
      ctaLabel="Create account + claim bonus"
      ctaHref={referralLink}
      ctaExternal={true}
      howItWorksHref="/star-citizen-referral-code/"
      sublineHtml="Account setup is the easy part. The harder part is picking a Free Fly session that gives you a fair first impression."
    />

    <section id="quick-answer" class="section">
      <div class="container">
        <h2 class="h2">Quick answer</h2>

        <div class="card pad" style="margin-bottom:12px;">
          <div class="kicker"><span class="dot"></span> Better timing</div>
          <p class="lead" style="margin-top:10px;">You cannot control global server load, but you can avoid giving the busiest possible moment the power to decide whether the game is for you.</p>
        </div>

        <ul class="bullets">
          <li><b>One calmer session beats one chaotic peak-hour session.</b> Your goal is a fair read, not maximum event exposure.</li>
          <li><b>Keep the first loop short and repeatable.</b> That makes it easier to compare regions, times, and session quality without getting trapped in a long bad run.</li>
          <li><b>This page only solves timing.</b> If you are already in a rough session, the queues-and-lag page is the narrower answer.</li>
          <li><b>If every session still feels rough,</b> stop treating it as a timing-only problem and check performance next.</li>
        </ul>
      </div>
    </section>

    <section id="do-this-now" class="section alt">
      <div class="container">
        <h2 class="h2">Do this now</h2>
        <ol class="steps">
          <li><b>Start with the closest region</b> and keep your first loop short enough to repeat elsewhere if needed.</li>
          <li><b>Avoid the busiest hubs for your first judgment call</b> and leave the city as quickly as you reasonably can.</li>
          <li><b>Test when you can take your time</b> instead of forcing the game into one rushed, crowded peak moment.</li>
          <li><b>If the session is bad, hop early</b> to a new session or region rather than wasting the whole trial proving the same point.</li>
          <li><b>Only then decide whether the timing improved enough</b> to make the trial feel fair.</li>
        </ol>
      </div>
    </section>

    <section id="common-mistakes" class="section">
      <div class="container">
        <h2 class="h2">What usually goes wrong</h2>
        <div class="tableWrap">
          <table class="table">
            <thead>
              <tr>
                <th>Mistake</th>
                <th>What happens</th>
                <th>Do this instead</th>
              </tr>
            </thead>
            <tbody>
              <tr><td><b>Using the worst event hour as the final verdict</b></td><td>You treat peak chaos like the normal state of the game.</td><td>Retest with one calmer session before you decide.</td></tr>
              <tr><td><b>Staying too long in a bad session</b></td><td>You lose time and learn almost nothing new.</td><td>Abort early and repeat a short loop elsewhere.</td></tr>
              <tr><td><b>Calling it a timing issue when it is rough everywhere</b></td><td>You miss the point where the problem might actually be setup or performance.</td><td>Move to the queues-and-lag page or the performance guide.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="next-steps" class="section alt">
      <div class="container">
        <h2 class="h2">Next steps</h2>
        <ul class="bullets">
          <li><a href={FREE_FLY_HUB_PATH}>Open the full Free Fly guide</a> if you want the wider event path around this timing question.</li>
          <li><a href="/free-fly-queues-and-server-lag-fix/">Already in a rough session? Use the session triage page</a> for the parts you can still control right now.</li>
          <li><a href="/free-fly-first-session/">Run the first-session plan</a> once the timing feels fair enough to judge the game properly.</li>
        </ul>
      </div>
    </section>

    <section id="faq" class="section">
      <div class="container">
        <h2 class="h2">FAQ</h2>
        <div class="faq" style="margin-top:12px;">
          {faqItems.map((item) => (
            <details class="faq__item">
              <summary class="faq__q">{item.q}</summary>
              <div class="faq__a">{item.a}</div>
            </details>
          ))}
        </div>
      </div>

      <FaqSchema items={faqItems} />
    </section>
  </main>
</BaseLayout>
