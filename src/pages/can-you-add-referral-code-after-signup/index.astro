---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReferralBanner from "../../components/ReferralBanner.astro";
import OnThisPage from "../../components/OnThisPage.astro";
import FaqSchema from "../../components/FaqSchema.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { REFERRAL_CODE, REFERRAL_LINK, REFERRAL_INFO_PATH } from "../../config/site";

const referralCode = REFERRAL_CODE;
const referralLink = REFERRAL_LINK;

const heroImg = "/assets/img/referral/star-citizen-referral-code-50000-uec-bonus-hero.webp";

const tocItems = [
  { id: "quick-answer", label: "Short answer" },
  { id: "do-this-now", label: "Check now" },
  { id: "common-mistakes", label: "What usually goes wrong" },
  { id: "next-steps", label: "Next step" },
  { id: "faq", label: "FAQ" }
];

const faqItems = [
  { q: "Can I add a referral code after I created my account?", a: "Yes, but only for a brand-new account and only inside the short 24-hour grace window RSI documents. Signup is still the normal path to plan around." },
  { q: "Where do I check that 24-hour backup window?", a: "Log in, click your user icon, and check the bottom of the RSI account summary panel for the referral entry box." },
  { q: "What if the field is already gone?", a: "Treat the referral step as missed. RSI says support cannot add the code after the account is created." },
  { q: "Will buying a starter pack fix it later?", a: "No. Buying later does not retroactively add the signup bonus." },
  { q: "Should I make a second account just for the bonus?", a: "Usually no. Keep one clean account unless you truly have no pledges and intentionally want to start over." }
];
---

<BaseLayout
  title="Add a Star Citizen Referral Code After Signup? | Star Citizen Beginner"
  description={`Brand-new RSI accounts can have a short 24-hour referral grace window after creation. Check the account summary now and treat this as recovery only.`}
  canonicalPath="/can-you-add-referral-code-after-signup/"
  pageType="satellite"
  pageTier="satellite"
  ogImage={heroImg}
  ogImageAlt="Can you add a Star Citizen referral code after signup"
  stickyCtaLabel="Create account + claim bonus"
  stickyCtaHref={referralLink}
  stickyCtaExternal={true}
  activeNav="guides"
>
  <main>
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Referral code", href: REFERRAL_INFO_PATH }, { label: "Add referral code after signup", href: "/can-you-add-referral-code-after-signup/" }]} />

    <section class="hero guideHero">
      <img
        class="hero__img"
        src={heroImg}
        alt="Can you add a Star Citizen referral code after signup"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1536"
        height="1024"
      />
      <div class="hero__overlay"></div>

      <div class="hero__content">
        <div class="guideHero__content">
          <div class="kicker"><span class="dot"></span> After signup</div>
          <h1 class="h1">Can you add a Star Citizen referral code after signup?</h1>
          <p class="lead" style="max-width: 820px;">Yes, but only as a short recovery step for a brand-new account. RSI says new accounts have a 24-hour grace window after creation, so this page is only about what to check right now.</p>

          <div class="hero__cta">
            <a class="btn primary" href="#quick-answer">Check the recovery path</a>
          </div>
        </div>

        <OnThisPage variant="hero" title="On this page" items={tocItems} />
      </div>
    </section>

    <ReferralBanner
      code={referralCode}
      bonus="50,000"
      ctaLabel="Create account + claim bonus"
      ctaHref={referralLink}
      ctaExternal={true}
    />

    <section id="quick-answer" class="section">
      <div class="container">
        <h2 class="h2">Quick answer</h2>

        <div class="card pad" style="margin-bottom: 12px;">
          <div class="kicker"><span class="dot"></span> Short answer</div>
          <p class="lead" style="margin-top: 10px;">Yes, for a brand-new account RSI says there is a short 24-hour grace window after account creation. Treat that as recovery, not as the normal path.</p>
        </div>

        <ul class="bullets">
          <li>Log in and check the bottom of your RSI account summary panel right away.</li>
          <li>If the referral entry box is still there, use it immediately and move on.</li>
          <li>If the box is gone, stop expecting a later fix. RSI says support cannot add the code after account creation.</li>
          <li>For every future signup, use the code during account creation and remove the problem before it starts.</li>
        </ul>

        <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px;">
          <a class="btn primary" href={referralLink} rel="nofollow noopener" target="_blank">Create account + claim bonus</a>
          <a class="btn ghost" href={REFERRAL_INFO_PATH}>Need the full referral guide? →</a>
        </div>
      </div>
    </section>

    <section id="do-this-now" class="section alt">
      <div class="container">
        <h2 class="h2">Check now</h2>
        <ol class="steps">
          <li><b>Confirm the account is brand-new</b> — this recovery path is only for the short window after creation.</li>
          <li><b>Log in to RSI</b> — click your user icon and open the account summary panel.</li>
          <li><b>Look for the referral entry box at the bottom</b> — if it is still there, enter the code immediately.</li>
          <li><b>If the box is gone</b> — keep the account and move on. Do not wait for a purchase to fix it later.</li>
        </ol>
      </div>
    </section>

    <section id="common-mistakes" class="section">
      <div class="container">
        <h2 class="h2">What usually goes wrong</h2>
        <div class="tableWrap">
          <table class="table">
            <thead>
              <tr>
                <th>Mistake</th>
                <th>What happens</th>
                <th>Do this instead</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><b>Treating the 24-hour box as the plan</b></td>
                <td>You turn a clean signup step into a recovery problem.</td>
                <td>Use the code during account creation whenever possible.</td>
              </tr>
              <tr>
                <td><b>Waiting until after you buy</b></td>
                <td>The purchase does not retroactively add the bonus.</td>
                <td>Separate signup from buying. Referral belongs to account creation.</td>
              </tr>
              <tr>
                <td><b>Making a second account immediately</b></td>
                <td>You create confusion around purchases, access, and future use.</td>
                <td>Keep one clean account unless you intentionally decide to restart.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="next-steps" class="section alt">
      <div class="container">
        <h2 class="h2">Next step</h2>
        <ul class="bullets">
          <li><a href={REFERRAL_INFO_PATH}>Main referral guide</a> — the full answer on timing, bonus, and the clean signup path.</li>
          <li><a href="/where-to-enter-referral-code/">Where to enter the code</a> — use this if you have not created the account yet.</li>
          <li><a href="/referral-code-not-working/">Referral code not working?</a> — use this if your real problem is a failed entry, not the recovery window itself.</li>
          <li><a href="/free-fly/">Free Fly</a> — keep the account and test the game before spending money.</li>
        </ul>
      </div>
    </section>

    <section id="faq" class="section">
      <div class="container">
        <h2 class="h2">FAQ</h2>
        <div class="faq" style="margin-top: 12px;">
          {faqItems.map((item) => (
            <details class="faq__item">
              <summary class="faq__q">{item.q}</summary>
              <div class="faq__a">{item.a}</div>
            </details>
          ))}
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px;">
          <a class="btn primary" href={referralLink} rel="nofollow noopener" target="_blank">Create account + claim bonus</a>
          <a class="btn ghost" href={REFERRAL_INFO_PATH}>Need the full referral guide? →</a>
        </div>
      </div>

      <FaqSchema items={faqItems} />
    </section>
  </main>
</BaseLayout>
