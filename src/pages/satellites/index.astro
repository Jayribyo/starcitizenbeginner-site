---
import BaseLayout from "../../layouts/BaseLayout.astro";

const targetHref = "/";
---

<BaseLayout
  title="Answer library moved | Star Citizen Beginner"
  description="This support page moved. Continue on the Star Citizen Beginner homepage."
  canonicalPath="/"
  activeNav="guides"
  robots="noindex,follow"
>
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0;url=${targetHref}`} />
  </Fragment>

  <main>
    <section class="section">
      <div class="container">
        <div class="card pad" style="max-width:760px; margin:48px auto; text-align:center;">
          <h1 class="h2" style="margin-top:0;">This page moved</h1>
          <p class="lead" style="margin:12px 0 18px;">The old answer library path is retired. Continue on the main Star Citizen Beginner hub.</p>
          <a class="btn primary" href={targetHref}>Go to homepage</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
