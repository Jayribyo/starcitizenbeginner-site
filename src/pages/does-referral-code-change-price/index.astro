---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReferralBanner from "../../components/ReferralBanner.astro";
import OnThisPage from "../../components/OnThisPage.astro";
import FaqSchema from "../../components/FaqSchema.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { REFERRAL_LINK, REFERRAL_INFO_PATH } from "../../config/site";

const referralLink = REFERRAL_LINK;
const heroImg = "/assets/img/referral/star-citizen-referral-code-50000-uec-bonus-hero.webp";

const tocItems = [
  { id: "quick-answer", label: "Short answer" },
  { id: "do-this-now", label: "What to do instead" },
  { id: "common-mistakes", label: "Common confusion" },
  { id: "next-steps", label: "Next step" },
  { id: "faq", label: "FAQ" }
];

const faqItems = [
  { q: "Does a Star Citizen referral code change the price?", a: "No. It is not a discount code and it does not change store prices." },
  { q: "What does it change then?", a: "It adds the signup bonus when you use it during account creation." },
  { q: "Should I wait until checkout to use it?", a: "No. Referral belongs to account creation, not checkout." },
  { q: "Does it change which starter pack I should buy?", a: "No. Choose your starter pack based on your budget and playstyle, not because of the referral step." },
  { q: "What should I do if price is my real concern?", a: "Decide whether the game is worth buying first, then compare the lowest sensible starter packs." }
];
---

<BaseLayout
  title="Does a Star Citizen Referral Code Change Price? | Star Citizen Beginner"
  description="No. A Star Citizen referral code is not a discount code. It adds the signup bonus during account creation and does not change the starter-pack price."
  canonicalPath="/does-referral-code-change-price/"
  pageType="satellite"
  pageTier="satellite"
  ogImage={heroImg}
  ogImageAlt="Does a Star Citizen referral code change the price"
  stickyCtaLabel="Create account + claim bonus"
  stickyCtaHref={referralLink}
  stickyCtaExternal={true}
  activeNav="guides"
>
  <main>
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Referral code", href: REFERRAL_INFO_PATH }, { label: "Does referral code change price?", href: "/does-referral-code-change-price/" }]} />

    <section class="hero guideHero">
      <img
        class="hero__img"
        src={heroImg}
        alt="Does a Star Citizen referral code change the price"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1536"
        height="1024"
      />
      <div class="hero__overlay"></div>

      <div class="hero__content">
        <div class="guideHero__content">
          <div class="kicker"><span class="dot"></span> Price check</div>
          <h1 class="h1">Does a Star Citizen referral code change the price?</h1>
          <p class="lead" style="max-width: 820px;">No. This page exists for one narrow checkout question so you can separate the signup bonus from the real buying decision.</p>

          <div class="hero__cta">
            <a class="btn primary" href="#quick-answer">Show the answer</a>
          </div>
        </div>

        <OnThisPage variant="hero" title="On this page" items={tocItems} />
      </div>
    </section>

    <ReferralBanner
      bonus="50,000"
      ctaLabel="Create account + claim bonus"
      ctaHref={referralLink}
      ctaExternal={true}
    />

    <section id="quick-answer" class="section">
      <div class="container">
        <h2 class="h2">Quick answer</h2>

        <div class="card pad" style="margin-bottom: 12px;">
          <div class="kicker"><span class="dot"></span> Short answer</div>
          <p class="lead" style="margin-top: 10px;">No. A referral code does not discount, increase, or otherwise change the price of a starter pack. It is a separate signup bonus step.</p>
        </div>

        <ul class="bullets">
          <li>Do not treat referral like a promo code or cart code.</li>
          <li>Use it during account creation if you want the signup bonus.</li>
          <li>The real money question comes after that: buy now, wait, or choose the cheapest sensible starter pack.</li>
          <li>Need the wider referral answer? Use the <a class="link" href={REFERRAL_INFO_PATH}>main referral guide</a>.</li>
        </ul>

        <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px;">
          <a class="btn primary" href={referralLink} rel="nofollow noopener" target="_blank">Create account + claim bonus</a>
          <a class="btn ghost" href={REFERRAL_INFO_PATH}>Need the full referral guide? →</a>
        </div>
      </div>
    </section>

    <section id="do-this-now" class="section alt">
      <div class="container">
        <h2 class="h2">What to do instead</h2>
        <ol class="steps">
          <li><b>Create the account with the referral code</b> — get the signup step out of the way once.</li>
          <li><b>Decide whether the game is worth buying</b> — use real playtime or the buy-or-wait page if you are unsure.</li>
          <li><b>Compare starter packs only after that</b> — choose the minimum sensible package instead of chasing a discount that does not exist.</li>
        </ol>
      </div>
    </section>

    <section id="common-mistakes" class="section">
      <div class="container">
        <h2 class="h2">Common confusion</h2>
        <div class="tableWrap">
          <table class="table">
            <thead>
              <tr>
                <th>Mistake</th>
                <th>What happens</th>
                <th>Do this instead</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><b>Expecting a price reduction</b></td>
                <td>You think the code failed when the cart does not change.</td>
                <td>Treat referral as a signup bonus, not a discount.</td>
              </tr>
              <tr>
                <td><b>Waiting for checkout</b></td>
                <td>You look for the wrong field at the wrong time.</td>
                <td>Use the code during account creation.</td>
              </tr>
              <tr>
                <td><b>Using referral to justify overspending</b></td>
                <td>You buy more than you need just because you see a bonus.</td>
                <td>Pick the cheapest sensible path once the game qualifies for you.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="next-steps" class="section alt">
      <div class="container">
        <h2 class="h2">Next step</h2>
        <ul class="bullets">
          <li><a href="/should-you-buy-star-citizen/">Should you buy Star Citizen?</a> — use this if price is your real hesitation.</li>
          <li><a href="/star-citizen-starter-packs/">Starter packs</a> — compare the cheapest sensible way in.</li>
          <li><a href="/how-to-buy-star-citizen/">How to buy Star Citizen</a> — the clean purchase path once you decide to spend.</li>
          <li><a href={REFERRAL_INFO_PATH}>Main referral guide</a> — the full answer on timing, bonus, and signup steps.</li>
        </ul>
      </div>
    </section>

    <section id="faq" class="section">
      <div class="container">
        <h2 class="h2">FAQ</h2>
        <div class="faq" style="margin-top: 12px;">
          {faqItems.map((item) => (
            <details class="faq__item">
              <summary class="faq__q">{item.q}</summary>
              <div class="faq__a">{item.a}</div>
            </details>
          ))}
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px;">
          <a class="btn primary" href={referralLink} rel="nofollow noopener" target="_blank">Create account + claim bonus</a>
          <a class="btn ghost" href={REFERRAL_INFO_PATH}>Need the full referral guide? →</a>
        </div>
      </div>

      <FaqSchema items={faqItems} />
    </section>
  </main>
</BaseLayout>
