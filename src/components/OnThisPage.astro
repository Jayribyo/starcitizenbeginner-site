---
/**
 * SCB OnThisPage (TOC) component
 *
 * Props:
 *  - items: Array<{ label: string, href: string }>
 *  - title: string
 *  - ariaLabel: string
 */
const {
  items = [],
  title = "On this page",
  ariaLabel = "On this page",
  variant = "section", // "section" | "hero"
} = Astro.props;
---

{variant === "hero" ? (
  <div class="hero__toc" aria-label={ariaLabel}>
    <div class="container">
      <div class:list={["card", "pad", "hero__tocCard", variant === "hero" && "hero__tocCard--hero"]}>
        <div class="kicker hero__tocKicker"><span class="dot"></span> {title}</div>
        <div class:list={["toc", variant === "hero" && "toc--hero", variant !== "hero" && "toc--section"]}>
          {items.map((it) => (
            <a href={it.href}>{it.label}</a>
          ))}
        </div>
      </div>
    </div>
  </div>
) : (
  <section class="section" aria-label={ariaLabel}>
    <div class="card pad">
      <div class="kicker hero__tocKicker"><span class="dot"></span> {title}</div>
      <div class:list={["toc", variant === "hero" && "toc--hero", variant !== "hero" && "toc--section"]}>
        {items.map((it) => (
          <a href={it.href}>{it.label}</a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .toc{
    display:flex;
    flex-wrap:wrap;
    gap:10px 14px;
    margin-top:10px;
    font-weight:800;
    font-size:13px;
    opacity:.92;
  }

  .toc a{
    border:1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.04);
    padding:8px 10px;
    border-radius:12px;
    transition: background .15s ease, border-color .15s ease, transform .15s ease, color .15s ease;
  }

  .toc a:hover{
    background: rgba(255,255,255,.07);
    border-color: rgba(255,255,255,.14);
    transform: translateY(-1px);
  }

  .hero__tocCard--hero{
    width:min(100%, 1040px);
    padding: 9px 11px 10px;
    background: rgba(255,255,255,.028);
    border-color: rgba(255,255,255,.08);
    box-shadow: 0 10px 24px rgba(0,0,0,.24);
  }

  .hero__tocKicker,
  .hero__tocCard--hero .hero__tocKicker{
    color: var(--scb-heading-tier-3) !important;
  }

  .hero__tocKicker .dot,
  .hero__tocCard--hero .hero__tocKicker .dot{
    background: rgba(208, 218, 232, 0.84) !important;
  }

  .toc--hero{
    gap: 6px 8px;
    margin-top: 8px;
    font-size: 11.5px;
    opacity: .96;
  }

  .toc--hero a{
    padding: 6px 9px;
    border-color: rgba(255,255,255,.08);
    background: rgba(255,255,255,.026);
    white-space: nowrap;
  }

  .toc--hero a:hover{
    background: rgba(255,255,255,.05);
    border-color: rgba(255,255,255,.12);
  }

  @media (min-width: 1181px){
    .hero__toc :global(.container){
      display:flex;
      justify-content:flex-start;
    }
  }

  @media (max-width: 991px){
    .hero__tocCard--hero{
      width:100%;
      padding: 9px 10px 10px;
    }

    .hero__tocKicker,
    .hero__tocCard--hero .hero__tocKicker{
      color: var(--scb-heading-tier-3) !important;
    }

    .toc--hero{
      display:grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 7px;
      margin-top: 8px;
      overflow: visible;
    }

    .toc--hero a{
      white-space: normal;
      display:flex;
      text-align: center;
      justify-content: center;
      align-items:center;
      min-height: 38px;
      line-height: 1.15;
      padding: 8px 9px;
      font-size: 11px;
    }
  }
</style>
