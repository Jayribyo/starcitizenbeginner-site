---
/**
 * SCB OnThisPage (TOC) component
 *
 * Props:
 *  - items: Array<{ label: string, href: string }>
 *  - title: string
 *  - ariaLabel: string
 */
const {
  items = [],
  title = "On this page",
  ariaLabel = "On this page",
  variant = "section", // "section" | "hero"
} = Astro.props;
---

{variant === "hero" ? (
  <div class="hero__toc" aria-label={ariaLabel}>
    <div class="container">
      <div class:list={["card", "pad", "hero__tocCard", variant === "hero" && "hero__tocCard--hero"]}>
        <div class="kicker hero__tocKicker" style="color: var(--scb-heading-tier-3); text-shadow: 0 1px 1px rgba(0,0,0,.18);"><span class="dot hero__tocDot" style="background: var(--scb-heading-tier-3);"></span> {title}</div>
        <div class:list={["toc", variant === "hero" && "toc--hero", variant !== "hero" && "toc--section"]}>
          {items.map((it) => (
            <a href={it.href}>{it.label}</a>
          ))}
        </div>
      </div>
    </div>
  </div>
) : (
  <section class="section" aria-label={ariaLabel}>
    <div class="card pad">
      <div class="kicker hero__tocKicker" style="color: var(--scb-heading-tier-3); text-shadow: 0 1px 1px rgba(0,0,0,.18);"><span class="dot hero__tocDot" style="background: var(--scb-heading-tier-3);"></span> {title}</div>
      <div class:list={["toc", variant === "hero" && "toc--hero", variant !== "hero" && "toc--section"]}>
        {items.map((it) => (
          <a href={it.href}>{it.label}</a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .toc{
    display:flex;
    flex-wrap:wrap;
    gap:9px 12px;
    margin-top:10px;
    font-weight:800;
    font-size:13px;
    opacity:.94;
  }

  .toc a{
    border:1px solid rgba(255,255,255,.09);
    background: rgba(255,255,255,.032);
    padding:8px 10px;
    border-radius:12px;
    transition: background .15s ease, border-color .15s ease, transform .15s ease, color .15s ease;
  }

  .toc a:hover{
    background: rgba(255,255,255,.055);
    border-color: rgba(255,255,255,.13);
    transform: translateY(-1px);
  }

  .hero__tocCard--hero{
    width:min(100%, 1040px);
    padding: 8px 10px 9px;
    background: rgba(255,255,255,.024);
    border-color: rgba(255,255,255,.075);
    box-shadow: 0 9px 22px rgba(0,0,0,.22);
  }

  .hero__tocKicker,
  .hero__tocCard--hero .hero__tocKicker{
    color: rgba(224, 232, 243, 0.94) !important;
  }

  .hero__tocDot,
  .hero__tocCard--hero .hero__tocDot{
    background: var(--scb-heading-tier-3) !important;
  }

  .toc--hero{
    align-items:flex-start;
    gap: 6px 7px;
    margin-top: 7px;
    font-size: 11.25px;
    opacity: .97;
  }

  .toc--hero a{
    padding: 6px 9px;
    border-color: rgba(255,255,255,.075);
    background: rgba(255,255,255,.022);
    white-space: nowrap;
  }

  .toc--hero a:hover{
    background: rgba(255,255,255,.045);
    border-color: rgba(255,255,255,.11);
  }

  @media (min-width: 1181px){
    .hero__toc :global(.container){
      display:flex;
      justify-content:flex-start;
    }

    .toc--hero{
      max-width: 100%;
    }
  }

  @media (max-width: 991px){
    .hero__tocCard--hero{
      width:100%;
      padding: 8px 9px 9px;
    }


    .toc--hero{
      display:grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
      margin-top: 7px;
      overflow: visible;
    }

    .toc--hero a{
      white-space: normal;
      display:flex;
      text-align: center;
      justify-content: center;
      align-items:center;
      min-height: 36px;
      line-height: 1.12;
      padding: 7px 8px;
      font-size: 10.6px;
    }
  }

  @media (max-width: 560px){
    .hero__tocCard--hero{
      padding: 8px 8px 9px;
    }

    .toc--hero{
      gap: 5px;
    }

    .toc--hero a{
      min-height: 34px;
      padding: 7px 7px;
      font-size: 10.2px;
      letter-spacing: 0;
    }
  }
</style>
